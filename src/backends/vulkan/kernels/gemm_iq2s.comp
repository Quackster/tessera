// "gemm_iq2s" contract (tessera API): buffer 0 is the activation A
// (fp32, m x k), buffer 1 the quantized weights W (IQ2_S, n x k),
// buffer 2 the output C (fp32, m x n). Scalars are 64-bit: m at
// pc.v[0], n at pc.v[2], k at pc.v[4] (a positive multiple of 256).
// An IQ2_S block is 82 bytes: d, 2-bit grid quants, high bits, scales.
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

