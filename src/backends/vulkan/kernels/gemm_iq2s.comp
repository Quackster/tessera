uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 256;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    uint base = row_w * (blocks * 82) + b * 82;
    float d = fp16_at(base);
    for (uint ib = 0; ib < 8; ++ib) {
      uint qh = wbyte(base + 66 + ib);
      uint sc = wbyte(base + 74 + ib);
      for (uint il = 0; il < 4; ++il) {
        uint gi = (wbyte(base + 2 + 4 * ib + il) |
                   ((qh << (8 - 2 * il)) & 0x300)) & 0x3FF;
        uint glo = kGridLo[gi];
        uint ghi = kGridHi[gi];
        float dl = d * (0.5 + float((sc >> (4 * (il / 2))) & 15)) * 0.25;
        uint signs = wbyte(base + 2 + 32 + 4 * ib + il);
        uint tu = b * 256 + ib * 32 + il * 8;
        for (uint j = 0; j < 4; ++j) {
          float m0 = ((signs & (1 << j)) > 0) ? -1.0 : 1.0;
          acc += a[row_a * k + tu + j] * (dl * float((glo >> (8 * j)) & 0xFF) * m0);
        }
        for (uint j = 0; j < 4; ++j) {
          float m1 = ((signs & (1 << (j + 4))) > 0) ? -1.0 : 1.0;
          acc += a[row_a * k + tu + 4 + j] * (dl * float((ghi >> (8 * j)) & 0xFF) * m1);
        }
      }
    }
  }
  c[idx] = acc;
}
