// Byte `offset` of the weight buffer (little-endian extraction).


uint wbyte(uint offset) {
  return uint(w[offset]);
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint split = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= m * n) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint blocks = k / 256u;
  uint per = blocks / split;
  uint b0 = gl_WorkGroupID.y * per;
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint w_base = row_w * (blocks * 110u);
  float acc = 0.0;
  uint ib = (lane / 8u) * 2u;
  uint part = (lane / 4u) & 1u;
  uint l0 = lane % 4u;
  for (uint b = b0; b < b0 + per; ++b) {
    uint base = w_base + b * 110u;
    float d = fp16_at(base);
    uint sbyte = wbyte(base + 106u + ib / 2u);
    float db = d * (1.0 + 2.0 * float(part == 0u ? (sbyte & 15u)
                                                 : (sbyte >> 4u)));
    uint qh = wbyte(base + 66u + ib + part);
    uint g1 = kGrid[wbyte(base + 2u + ib * 8u + 2u * l0) |
                    ((qh << (8u - 2u * l0)) & 256u)];
    uint g2 = kGrid[wbyte(base + 2u + ib * 8u + 2u * l0 + 1u) |
                    ((qh << (7u - 2u * l0)) & 256u)];
    uint signs = wbyte(base + 74u + ib * 4u + part * 4u + l0);
    uint t = b * 256u + ib * 32u + part * 32u + l0 * 8u;
    for (uint j = 0u; j < 4u; ++j) {
      float m1 = ((signs & (1u << j)) > 0u) ? -1.0 : 1.0;
      float m2 = ((signs & (1u << (j + 4u))) > 0u) ? -1.0 : 1.0;
      acc += a[row_a * k + t + j] * (db * float((g1 >> (8u * j)) & 0xFFu) * m1);
      acc += a[row_a * k + t + 4u + j] *
             (db * float((g2 >> (8u * j)) & 0xFFu) * m2);
    }
  }

  float sum = reduce32(acc);
  if ((gl_SubgroupInvocationID % 32u) == 0u) {
    c[gl_WorkGroupID.y * (m * n) + idx] = sum;
  }
}
