#version 450

// One workgroup per 256 output elements; the dispatch is
// ceil(m * n / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "gemm_q4k" contract (tessera API): buffer 0 is the activation A
// (fp32, m x k), buffer 1 the quantized weights W (Q4_K, n x k),
// buffer 2 the output C (fp32, m x n). Scalars are 64-bit, so field m
// lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

// Q4_K blocks are 144 bytes (a multiple of 4), so the whole buffer can
// be viewed as uint words; bytes are extracted with a shift and mask.
layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// Byte `offset` of the Q4_K buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact (port of the core
// Fp16ToFloat in src/core/numerics/quant.cpp).
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    // The Vulkan GLSL subset has no nan()/inf() built-ins; the IEEE
    // results come from the division.
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j from the 12-byte packing
// (port of the core GetScaleMin; the rocm kernel uses the same formula).
// `base` is the byte offset of the block header; the packing spans
// bytes base+4 .. base+15.
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);  // used only for j >= 4
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 256;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    uint base = row_w * (blocks * 144) + b * 144;
    float d = fp16_at(base);
    float dm = fp16_at(base + 2);
    for (uint grp = 0; grp < 4; ++grp) {
      uint sc0, mn0, sc1, mn1;
      scale_min4(grp * 2, base, sc0, mn0);
      scale_min4(grp * 2 + 1, base, sc1, mn1);
      float a0 = d * float(sc0);
      float o0 = dm * float(mn0);
      float a1 = d * float(sc1);
      float o1 = dm * float(mn1);
      for (uint l = 0; l < 32; ++l) {
        uint q = wbyte(base + 16 + grp * 32 + l);
        uint t = b * 256 + grp * 64 + l;
        acc += a[row_a * k + t] * (a0 * float(q & 15) - o0);
        acc += a[row_a * k + t + 32] * (a1 * float(q >> 4) - o1);
      }
    }
  }
  c[idx] = acc;
}
