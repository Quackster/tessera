#version 450

// One workgroup per row (shared-memory sum reduction); the dispatch is
// `rows` workgroups of 256 via grid_x.
layout(local_size_x = 256) in;

// "l2norm" contract: buffer 0 is X (rows x cols), buffer 1 the output
// Y. Scalars: rows v[0], cols v[2], epsilon fp32 bits v[4], scale fp32
// bits v[6] (Y = scale * X / sqrt(sum(X^2) + eps)).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer X {
  float x[];
};

layout(set = 0, binding = 1) writeonly buffer Y {
  float y[];
};

shared float red[256];

void main() {
  // One workgroup per row (shared-memory sum reduction).
  uint r = gl_WorkGroupID.x;
  uint rows = pc.v[0];
  if (r >= rows) {
    return;
  }
  uint cols = pc.v[2];
  float eps = uintBitsToFloat(pc.v[4]);
  float scale = uintBitsToFloat(pc.v[6]);
  uint tid = gl_LocalInvocationID.x;
  uint base = r * cols;
  float sum = 0.0;
  for (uint c = tid; c < cols; c += 256u) {
    sum = fma(x[base + c], x[base + c], sum);
  }
  red[tid] = sum;
  barrier();
  for (uint st = 128u; st > 0u; st >>= 1u) {
    if (tid < st) {
      red[tid] += red[tid + st];
    }
    barrier();
  }
  float gain = scale / sqrt(red[0] + eps);
  for (uint c = tid; c < cols; c += 256u) {
    y[base + c] = x[base + c] * gain;
  }
}
