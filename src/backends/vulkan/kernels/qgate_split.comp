#version 450

// One thread per (row, head, element); the dispatch is
// ceil(rows * heads * head_dim / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "qgate_split" contract: buffer 0 is the fused gated-attention
// projection (rows per head query then gate), buffer 1 the queries,
// buffer 2 the gates. Scalars: heads v[0], head_dim v[2], rows v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer Fused {
  float fused[];
};

layout(set = 0, binding = 1) writeonly buffer Q {
  float q[];
};

layout(set = 0, binding = 2) writeonly buffer G {
  float g[];
};

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint heads = pc.v[0];
  uint head_dim = pc.v[2];
  uint rows = pc.v[4];
  if (t >= rows * heads * head_dim) {
    return;
  }
  uint row = t / (heads * head_dim);
  uint rem = t % (heads * head_dim);
  uint head = rem / head_dim;
  uint e = rem % head_dim;
  uint fbase = (row * heads + head) * 2 * head_dim;
  uint obase = row * heads * head_dim + head * head_dim;
  q[obase + e] = fused[fbase + e];
  g[obase + e] = fused[fbase + head_dim + e];
}
