#version 450

// One workgroup per row; the dispatch is `rows` workgroups via grid_x.
// The row sum runs across the workgroup so a single-row decode step does
// not serialize 5120 elements on one thread.
layout(local_size_x = 256) in;

// "rmsnorm" contract: buffers X (rows x cols), W (cols), Y (out).
// Scalars: rows v[0], cols v[2], epsilon fp32 bits v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer X {
  float x[];
};

layout(set = 0, binding = 1) readonly buffer W {
  float w[];
};

layout(set = 0, binding = 2) writeonly buffer Y {
  float y[];
};

shared float partial[256];

void main() {
  uint r = gl_WorkGroupID.x;
  uint rows = pc.v[0];
  if (r >= rows) {
    return;
  }
  uint cols = pc.v[2];
  float eps = uintBitsToFloat(pc.v[4]);
  uint lid = gl_LocalInvocationID.x;
  float sum = 0.0;
  for (uint c = lid; c < cols; c += 256) {
    float value = x[r * cols + c];
    sum += value * value;
  }
  partial[lid] = sum;
  barrier();
  for (uint s = 128; s > 0; s >>= 1) {
    if (lid < s) {
      partial[lid] += partial[lid + s];
    }
    barrier();
  }
  float mean = partial[0] / float(cols);
  float gain = inversesqrt(mean + eps);
  for (uint c = lid; c < cols; c += 256) {
    y[r * cols + c] = x[r * cols + c] * gain * w[c];
  }
}
