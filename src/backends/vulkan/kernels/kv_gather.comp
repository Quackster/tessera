#version 450

// One thread per pair of consecutive head dims; the dispatch is
// ceil(n_ids * n_head_kv * head_dim / 2 / 256). head_dim is even.
layout(local_size_x = 256) in;

// "kv_gather" contract: buffer 0 is the K pool (fp16 packed two per
// uint), buffer 1 the V pool, buffer 2 the page table (i32), buffer 3 the
// ids (i32), buffer 4 the K scratch, buffer 5 the V scratch. Scalars:
// n_ids (v[0]), n_head_kv (v[2]), head_dim (v[4]), page_size (v[6]).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer KP { uint kp[]; };
layout(set = 0, binding = 1) readonly buffer VP { uint vp[]; };
layout(set = 0, binding = 2) readonly buffer PT { uint pt[]; };
layout(set = 0, binding = 3) readonly buffer ID { uint ids[]; };
layout(set = 0, binding = 4) writeonly buffer KS { uint ks[]; };
layout(set = 0, binding = 5) writeonly buffer VS { uint vs[]; };

uint wbyte(uint src, uint off) {
  return (src >> ((off & 3u) << 3)) & 0xFFu;
}

float fp16_word(uint word, uint byte_off) {
  uint h = (word >> ((byte_off & 3u) << 3)) & 0xFFFFu;
  if ((byte_off & 3u) == 3u) {
    h = word >> 24;
  }
  uint exp = (h >> 10) & 31u;
  uint man = h & 1023u;
  float value;
  if (exp == 0u) {
    value = float(man) * exp2(-24.0);
  } else if (exp == 31u) {
    value = man > 0u ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(man) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768u) > 0u ? -value : value;
}

float kp16(uint elem) {
  return fp16_word(kp[elem >> 1], (elem & 1u) << 1);
}

float vp16(uint elem) {
  return fp16_word(vp[elem >> 1], (elem & 1u) << 1);
}

uint f16_word(float value) {
  uint bits = floatBitsToUint(value);
  uint sign = (bits >> 16) & 0x8000u;
  uint exp = (bits >> 23) & 0xFFu;
  uint mant = bits & 0x7FFFFFu;
  if (exp == 0xFFu) {
    return sign | 0x7C00u | (mant != 0u ? 0x200u : 0u);
  }
  int e = int(exp) - 127;
  if (e > 15) {
    return sign | 0x7C00u;
  }
  uint m = mant;
  if (e < -14) {
    uint scaled = mant | 0x800000u;
    int shift = -e - 1;
    if (shift >= 32) {
      return sign;
    }
    uint mask = (1u << uint(shift)) - 1u;
    uint halfway = 1u << uint(shift - 1);
    uint rem = scaled & mask;
    uint q = scaled >> uint(shift);
    if (rem > halfway || (rem == halfway && (q & 1u) == 1u)) {
      q += 1u;
    }
    if (q > 1023u) {
      return sign | 0x0400u;
    }
    return sign | q;
  }
  uint mask = (1u << 13u) - 1u;
  uint halfway = 1u << 12u;
  uint rem = m & mask;
  uint q = m >> 13u;
  if (rem > halfway || (rem == halfway && (q & 1u) == 1u)) {
    q += 1u;
  }
  if (q > 1023u) {
    if (e + 1 > 15) {
      return sign | 0x7C00u;
    }
    return sign | (uint(e + 1 + 15) << 10);
  }
  return sign | (uint(e + 15) << 10) | q;
}

void main() {
  uint n_ids = pc.v[0];
  uint n_head_kv = pc.v[2];
  uint head_dim = pc.v[4];
  uint page_size = pc.v[6];
  uint pairs = n_ids * n_head_kv * head_dim / 2u;
  uint p = gl_GlobalInvocationID.x;
  if (p >= pairs) {
    return;
  }
  uint e = 2u * p;
  uint d = e % head_dim;
  uint t = e / head_dim;
  uint h = t % n_head_kv;
  uint j = t / n_head_kv;
  uint id = ids[j];
  uint physical = pt[id / page_size];
  uint base = (physical * n_head_kv + h) * page_size + (id % page_size);
  uint src = base * head_dim + d;
  float k0 = kp16(src);
  float k1 = kp16(src + 1u);
  float v0 = vp16(src);
  float v1 = vp16(src + 1u);
  ks[p] = f16_word(k0) | (f16_word(k1) << 16);
  vs[p] = f16_word(v0) | (f16_word(v1) << 16);
}
