#version 450

#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require

// Fused routed-expert down projection for one token (Q4_K variant). See
// moe_experts_down_q6k for the contract; this decodes the Q4_K [hidden,
// inter] per-expert layout.
layout(local_size_x = 256) in;

// "moe_experts_down_q4k" contract: buffers Phi (top_k x inter fp32), Down
// (3D Q4_K), Ids (top_k u32), Wts (top_k fp32), Out (hidden fp32). Scalars:
// hidden v[0], inter v[2], top_k v[4], down_stride v[6]. Grid:
// grid_x = ceil(hidden / 8).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer Phi { float phi[]; };
layout(set = 0, binding = 1) readonly buffer Down { uint8_t d[]; };
layout(set = 0, binding = 2) readonly buffer Ids { uint ids[]; };
layout(set = 0, binding = 3) readonly buffer Wts { float wts[]; };
layout(set = 0, binding = 4) buffer Out { float outv[]; };

float reduce32(float v) {
  return subgroupClusteredAdd(v, 32u);
}

uint dbyte(uint offset) {
  return uint(d[offset]);
}

float dfp16(uint offset) {
  uint h = dbyte(offset) | (dbyte(offset + 1) << 8);
  uint e = (h >> 10) & 31;
  uint m = h & 1023;
  float value;
  if (e == 0) {
    value = float(m) * exp2(-24.0);
  } else if (e == 31) {
    value = m > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(m) / 1024.0) * exp2(float(e) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void dscale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = dbyte(base + 4 + j);
  uint sj4 = dbyte(base + 8 + j);
  uint sjm4 = dbyte(base + j);
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

void main() {
  uint hidden = pc.v[0];
  uint inter = pc.v[2];
  uint top_k = pc.v[4];
  uint down_stride = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= hidden) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint blocks = inter / 256u;
  float acc = 0.0;
  for (uint slot = 0u; slot < top_k; ++slot) {
    uint expert = ids[slot];
    float w = wts[slot];
    uint base = expert * down_stride + idx * (blocks * 144u);
    uint phi_base = slot * inter;
    float dot = 0.0;
    for (uint b = 0u; b < blocks; ++b) {
      uint bb = base + b * 144u;
      float dscale = dfp16(bb);
      float dmin = dfp16(bb + 2u);
      for (uint grp = 0u; grp < 4u; ++grp) {
        uint sc0, mn0, sc1, mn1;
        dscale_min4(grp * 2u, bb, sc0, mn0);
        dscale_min4(grp * 2u + 1u, bb, sc1, mn1);
        uint q = dbyte(bb + 16u + grp * 32u + lane);
        uint t = b * 256u + grp * 64u + lane;
        dot += phi[phi_base + t] *
               (dscale * float(sc0) * float(q & 15u) - dmin * float(mn0));
        dot += phi[phi_base + t + 32u] *
               (dscale * float(sc1) * float(q >> 4) - dmin * float(mn1));
      }
    }
    acc += w * reduce32(dot);
  }
  uint accumulate = pc.v[8];
  if ((gl_SubgroupInvocationID % 32u) == 0u) {
    outv[idx] = accumulate != 0u ? outv[idx] + acc : acc;
  }
}
