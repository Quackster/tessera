    120u, 249u, 250u, 123u, 252u, 125u, 126u, 255u
);

uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 256;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    uint base = row_w * (blocks * 98) + b * 98;
    float d = fp16_at(base);
    for (uint ib = 0; ib < 8; ++ib) {
      uint gas0 = wbyte(base + 66 + 4 * ib) | (wbyte(base + 66 + 4 * ib + 1) << 8);
      uint gas1 = wbyte(base + 66 + 4 * ib + 2) | (wbyte(base + 66 + 4 * ib + 3) << 8);
      uint aux32 = gas0 | (gas1 << 16);
      float dl = d * (0.5 + float(aux32 >> 28)) * 0.5;
      for (uint il = 0; il < 4; ++il) {
        uint g1 = kGrid[wbyte(base + 2 + 8 * ib + 2 * il)];
        uint g2 = kGrid[wbyte(base + 2 + 8 * ib + 2 * il + 1)];
        uint signs = kSigns[(aux32 >> (7 * il)) & 127];
        uint t = b * 256 + ib * 32 + il * 8;
        for (uint j = 0; j < 4; ++j) {
          float m1 = ((signs & (1 << j)) > 0) ? -1.0 : 1.0;
          float m2 = ((signs & (1 << (j + 4))) > 0) ? -1.0 : 1.0;
          acc += a[row_a * k + t + j] * (dl * float((g1 >> (8 * j)) & 0xFF) * m1);
          acc += a[row_a * k + t + 4 + j] * (dl * float((g2 >> (8 * j)) & 0xFF) * m2);
        }
      }
    }
  }
  c[idx] = acc;
}
