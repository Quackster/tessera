// IQ2 sign table (128 entries, one byte each).
const uint kSigns[128] = uint[128](
    0u, 129u, 130u, 3u, 132u, 5u, 6u, 135u, 136u, 9u, 10u, 139u,
    12u, 141u, 142u, 15u, 144u, 17u, 18u, 147u, 20u, 149u, 150u, 23u,
