#version 450

// One thread per row.
layout(local_size_x = 256) in;

// "layernorm" contract: buffer 0 X (fp32, rows x cols), buffer 1 weight
// (fp32, cols), buffer 2 bias (fp32, cols), buffer 3 the output (fp32,
// rows x cols). Scalars: rows v[0], cols v[2], eps fp32 bits v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer X { float x[]; };
layout(set = 0, binding = 1) buffer W { float w[]; };
layout(set = 0, binding = 2) buffer B { float b[]; };
layout(set = 0, binding = 3) buffer Y { float y[]; };

void main() {
  uint r = gl_GlobalInvocationID.x;
  uint rows = pc.v[0];
  uint cols = pc.v[2];
  if (r >= rows) {
    return;
  }
  uint base = r * cols;
  float mean = 0.0;
  for (uint c = 0; c < cols; ++c) {
    mean += x[base + c];
  }
  mean /= float(cols);
  float var = 0.0;
  for (uint c = 0; c < cols; ++c) {
    float d = x[base + c] - mean;
    var += d * d;
  }
  var /= float(cols);
  float eps = uintBitsToFloat(pc.v[4]);
  float inv = inversesqrt(var + eps);
  for (uint c = 0; c < cols; ++c) {
    y[base + c] = (x[base + c] - mean) * inv * w[c] + b[c];
  }
}
