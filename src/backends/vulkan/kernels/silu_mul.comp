#version 450

// One thread per element; the dispatch is ceil(n / 256) workgroups.
layout(local_size_x = 256) in;

// "silu_mul" contract: buffers G, U, O (fp32, n each);
// O = silu(G) * U.
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer G { float g[]; };
layout(set = 0, binding = 1) buffer U { float u[]; };
layout(set = 0, binding = 2) buffer O { float o[]; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.v[0]) {
    return;
  }
  float gate = g[i];
  o[i] = (gate / (1.0 + exp(-gate))) * u[i];
}
