// Byte `offset` of the weight buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 256;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    uint base = row_w * (blocks * 110) + b * 110;
    float d = fp16_at(base);
    for (uint ib = 0; ib < 8; ib += 2) {
      float db1 = d * (1.0 + 2.0 * float(wbyte(base + 106 + ib / 2) & 15));
      float db2 = d * (1.0 + 2.0 * float(wbyte(base + 106 + ib / 2) >> 4));
      for (uint part = 0; part < 2; ++part) {
        float db = part == 0 ? db1 : db2;
        uint qh = wbyte(base + 66 + ib + part);
        for (uint l = 0; l < 4; ++l) {
          uint g1 = kGrid[wbyte(base + 2 + ib * 8 + 2 * l) |
                          ((qh << (8 - 2 * l)) & 256)];
          uint g2 = kGrid[wbyte(base + 2 + ib * 8 + 2 * l + 1) |
                          ((qh << (7 - 2 * l)) & 256)];
          uint signs = wbyte(base + 74 + ib * 4 + part * 4 + l);
          for (uint j = 0; j < 4; ++j) {
            float m1 = ((signs & (1 << j)) > 0) ? -1.0 : 1.0;
            float m2 = ((signs & (1 << (j + 4))) > 0) ? -1.0 : 1.0;
            uint t = b * 256 + (ib * 32) + part * 32 + l * 8;
            acc += a[row_a * k + t + j] *
                   (db * float((g1 >> (8 * j)) & 0xFF) * m1);
            acc += a[row_a * k + t + 4 + j] *
                   (db * float((g2 >> (8 * j)) & 0xFF) * m2);
          }
        }
      }
    }
  }
  c[idx] = acc;
}
