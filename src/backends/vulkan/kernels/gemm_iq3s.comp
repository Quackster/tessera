#version 450

// One workgroup per 256 output elements; the dispatch is
// ceil(m * n / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "gemm_iq3s" contract (tessera API): buffer 0 is the activation A
// (fp32, m x k), buffer 1 the quantized weights W (IQ3_S, n x k),
// buffer 2 the output C (fp32, m x n). Scalars are 64-bit: m at
// pc.v[0], n at pc.v[2], k at pc.v[4] (a positive multiple of 256).
// An IQ3_S block is 110 bytes: d, 3-bit grid quants, signs, scales.
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

