#version 450

// One workgroup per 256 output elements; the dispatch is
// ceil(m * n / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "gemm_mxfp4" contract (tessera API): buffer 0 is A (fp32, m x k),
// buffer 1 the packed MXFP4 weights W (n x k/2 blob bytes followed by
// the n x k/32 E8M0 scale bytes, two E2M1 nibbles per byte, low nibble
// first), buffer 2 the output C (fp32, m x n). The scale bytes start at
// offset n*k/2 in W. Scalars are 64-bit, so field k lives at pc.v[2k]:
// m v[0], n v[2], k v[4] (a positive multiple of 32).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// Byte `offset` of the packed weight buffer viewed as uint words.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// OCP MX E2M1 nibble values (port of the core F4E2M1ToFloat). A table
// lookup avoids the branch and the ldexp in the hot loop.
const float kE2M1[16] = float[16](
    0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 32;
  uint scale_base = (n * k) >> 1;
  uint a_base = row_a * k;
  uint w_base = row_w * k;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    float scale = exp2(float(wbyte(scale_base + row_w * blocks + b)) - 127.0);
    uint base = b * 32;
    // A 32-bit word holds eight nibbles, so load one word per eight
    // elements instead of one byte per two. `w_base + base` is an element
    // index; /2 gives bytes and /4 words, so the shift is 3.
    uint word = (w_base + base) >> 3;
    for (uint q = 0; q < 4; ++q) {
      uint bits = w[word + q];
      for (uint j = 0; j < 8; ++j) {
        acc += a[a_base + base + q * 8 + j] * (scale * kE2M1[bits & 15u]);
        bits >>= 4;
      }
    }
  }
  c[idx] = acc;
}
