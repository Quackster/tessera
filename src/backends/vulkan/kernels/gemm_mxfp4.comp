#version 450

// One workgroup per 256 output elements; the dispatch is
// ceil(m * n / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "gemm_mxfp4" contract (tessera API): buffer 0 is A (fp32, m x k),
// buffer 1 the MXFP4 weights W (n x k/2 bytes, two E2M1 nibbles per
// byte, low nibble first), buffer 2 the E8M0 scales (n x k/32
// bytes), buffer 3 the output C (fp32, m x n). Scalars are 64-bit,
// so field k lives at pc.v[2k]: m v[0], n v[2], k v[4] (a positive
// multiple of 32).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer S {
  uint s[];
};

layout(set = 0, binding = 3) buffer C {
  float c[];
};

// Byte `offset` of a byte buffer viewed as uint words.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

uint sbyte(uint offset) {
  return (s[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// OCP MX E2M1 nibble to fp32 (port of the core F4E2M1ToFloat).
float e2m1(uint nib) {
  uint s = (nib >> 3) & 1;
  uint e = (nib >> 1) & 3;
  uint m = nib & 1;
  float value;
  if (e == 0) {
    value = float(m) * 0.5;
  } else if (e == 3 && m == 1) {
    value = 0.0 / 0.0;
  } else {
    value = (1.0 + float(m) / 2.0) * exp2(float(e) - 1.0);
  }
  return s > 0 ? -value : value;
}

void main() {
  uint idx = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (idx >= m * n) {
    return;
  }
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint blocks = k / 32;
  float acc = 0.0;
  for (uint b = 0; b < blocks; ++b) {
    float scale = exp2(float(sbyte(row_w * blocks + b)) - 127.0);
    for (uint l = 0; l < 32; ++l) {
      uint t = b * 32 + l;
      uint packed = wbyte((row_w * k + t) >> 1);
      uint nib = (t & 1) == 0 ? packed & 15 : packed >> 4;
      acc += a[row_a * k + t] * (scale * e2m1(nib));
    }
  }
  c[idx] = acc;
}
