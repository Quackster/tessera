#version 450

#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require


// Multi-row Q6_K GEMV ("gemm_q6k_rows4"): one warp per\n// weight column decodes each 210-byte superblock once for all m rows\n// (m = 2..4). See gemm_q4k_rows.comp for the launch contract.
layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint8_t w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// 32-lane (warp-equivalent) reduction; the cluster leader writes the
// result. Replaces a shared-memory tree with five barriers per output.
float reduce32(float v) {
  return subgroupClusteredAdd(v, 32u);
}



uint wbyte(uint offset) {
  return uint(w[offset]);
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}


void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint split = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint warp = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  uint lane = gl_LocalInvocationID.x % 32u;
  if (warp >= n) {
    return;
  }
  uint rows = 4u;
  uint blocks = k / 256u;
  uint per = blocks / split;
  uint b0 = gl_WorkGroupID.y * per;
  uint wbase = warp * (blocks * 210u) + b0 * 210u;
  float acc[4] = float[4](0.0, 0.0, 0.0, 0.0);
  uint is = lane >> 4u;
  for (uint b = 0u; b < per; ++b) {
    uint base = wbase + b * 210u;
    float d = fp16_at(base + 208u);
    for (uint n2 = 0u; n2 < 2u; ++n2) {
      int s0 = int(wbyte(base + 192u + n2 * 8u + is));
      int s1 = int(wbyte(base + 192u + n2 * 8u + is + 2u));
      int s2 = int(wbyte(base + 192u + n2 * 8u + is + 4u));
      int s3 = int(wbyte(base + 192u + n2 * 8u + is + 6u));
      if (s0 >= 128) { s0 -= 256; }
      if (s1 >= 128) { s1 -= 256; }
      if (s2 >= 128) { s2 -= 256; }
      if (s3 >= 128) { s3 -= 256; }
      uint ql0 = wbyte(base + n2 * 64u + lane);
      uint ql1 = wbyte(base + n2 * 64u + 32u + lane);
      uint qh = wbyte(base + 128u + n2 * 32u + lane);
      float q1 = float(int((ql0 & 15u) | (((qh >> 0) & 3u) << 4)) - 32);
      float q2 = float(int((ql1 & 15u) | (((qh >> 2) & 3u) << 4)) - 32);
      float q3 = float(int((ql0 >> 4) | (((qh >> 4) & 3u) << 4)) - 32);
      float q4 = float(int((ql1 >> 4) | (((qh >> 6) & 3u) << 4)) - 32);
      uint t0 = (b0 + b) * 256u + n2 * 128u + lane;
      for (uint r = 0u; r < 4u; ++r) {
        if (r < rows) {
          uint t = r * k + t0;
          acc[r] += a[t] * (d * float(s0) * q1);
          acc[r] += a[t + 32u] * (d * float(s1) * q2);
          acc[r] += a[t + 64u] * (d * float(s2) * q3);
          acc[r] += a[t + 96u] * (d * float(s3) * q4);
        }
      }
    }
  }

  uint out_base = gl_WorkGroupID.y * (m * n);
  for (uint r = 0u; r < 4u; ++r) {
    if (r < rows) {
      float sum = reduce32(acc[r]);
      if ((gl_SubgroupInvocationID % 32u) == 0u) {
        c[out_base + r * n + warp] = sum;
      }
    }
  }
}
