#version 450

// Tiled batched Q4_K GEMM: one workgroup handles 8 activation rows x one
// weight column; the Q4_K block is dequantized once into shared memory
// and reused across the 8 rows. The 8 dots accumulate in the gemm_q4k
// element order so the batch matches the sequential forward.
// Dispatch is ceil(m / 8) * n workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_q4k_batched" contract (tessera API): buffers and scalars match
// gemm_q4k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

// Q4_K blocks are 144 bytes (a multiple of 4), so the whole buffer can
// be viewed as uint words; bytes are extracted with a shift and mask.
layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// Byte `offset` of the Q4_K buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact (port of the core
// Fp16ToFloat in src/core/numerics/quant.cpp).
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j from the 12-byte packing
// (port of the core GetScaleMin). `base` is the byte offset of the
// block header.
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);  // used only for j >= 4
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

shared float wq[256];

void main() {
  uint wg = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tm = wg / n;
  uint row_w = wg % n;
  uint base_row = tm * 8u;
  bool dot_valid = tid < 8u && base_row + tid < m;
  uint row_a = base_row + tid;
  uint blocks = k / 256u;
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = row_w * (blocks * 144u) + b * 144u;
    float d = fp16_at(base);
    float dm = fp16_at(base + 2u);
    uint e = tid;
    uint grp = e / 64u;
    uint hi = (e % 64u) / 32u;
    uint l = e % 32u;
    uint sc, mn;
    scale_min4(grp * 2u + hi, base, sc, mn);
    uint q = wbyte(base + 16u + grp * 32u + l);
    uint nib = hi == 0u ? (q & 15u) : (q >> 4u);
    wq[e] = d * float(sc) * float(nib) - dm * float(mn);
    barrier();
    if (dot_valid) {
      for (uint g = 0u; g < 4u; ++g) {
        for (uint ll = 0u; ll < 32u; ++ll) {
          uint t0 = g * 64u + ll;
          uint t1 = t0 + 32u;
          uint i0 = row_a * k + b * 256u + t0;
          uint i1 = row_a * k + b * 256u + t1;
          acc += a[i0] * wq[t0];
          acc += a[i1] * wq[t1];
        }
      }
    }
    barrier();
  }
  if (dot_valid) {
    c[row_a * n + row_w] = acc;
  }
}
