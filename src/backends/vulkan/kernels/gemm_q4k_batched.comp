#version 450

// Tiled batched Q4_K GEMM: one workgroup covers 32 activation rows x 8
// weight columns with one thread per output, so every thread computes.
// The earlier 8-row tile left 248 of 256 threads dequantizing only and
// held the prefill back. Each thread decodes its own column's block, and
// the per-output accumulation keeps the gemm_q4k element order (per
// 64-element group, the low 32 then the high 32), so the batch matches
// the sequential forward.
// Dispatch is ceil(m / 32) * ceil(n / 8) workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_q4k_batched" contract (tessera API): buffers and scalars match
// gemm_q4k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

// Q4_K blocks are 144 bytes (a multiple of 4), so the whole buffer can
// be viewed as uint words; bytes are extracted with a shift and mask.
layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

// Byte `offset` of the Q4_K buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact (port of the core
// Fp16ToFloat in src/core/numerics/quant.cpp).
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j from the 12-byte packing
// (port of the core GetScaleMin). `base` is the byte offset of the
// block header.
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);  // used only for j >= 4
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 7u) / 8u;
  uint wg = gl_WorkGroupID.x;
  uint row_a = (wg / col_tiles) * 32u + tid / 8u;
  uint row_w = (wg % col_tiles) * 8u + tid % 8u;
  if (row_a >= m || row_w >= n) {
    return;
  }
  uint blocks = k / 256u;
  uint abase = row_a * k;
  uint wbase = row_w * (blocks * 144u);
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = wbase + b * 144u;
    float d = fp16_at(base);
    float dm = fp16_at(base + 2u);
    // Element order (0..255), matching the host reference exactly.
    for (uint g = 0u; g < 4u; ++g) {
      for (uint hf = 0u; hf < 2u; ++hf) {
        uint sc, mn;
        scale_min4(g * 2u + hf, base, sc, mn);
        float dsc = d * float(sc);
        float dmm = dm * float(mn);
        for (uint l = 0u; l < 32u; ++l) {
          uint q = wbyte(base + 16u + g * 32u + l);
          uint nib = hf == 0u ? (q & 15u) : (q >> 4u);
          acc += a[abase + b * 256u + g * 64u + hf * 32u + l] *
                 (dsc * float(nib) - dmm);
        }
      }
    }
  }
  c[row_a * n + row_w] = acc;
}
