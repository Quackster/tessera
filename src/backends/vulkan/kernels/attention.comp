#version 450

// One thread per output element; the dispatch is
// ceil(m * heads * head_dim / 256) workgroups via grid_x.
layout(local_size_x = 256) in;

// "attention" contract (tessera API): q is m x heads*head_dim fp32,
// k and v are n x kv_heads*head_dim, out is m x heads*head_dim.
// Scalars are 64-bit, so field k lives at pc.v[2k]: m v[0], n v[2],
// heads v[4], kv_heads v[6], head_dim v[8], q_base v[10], window v[12].
// Query row i sits at q_base + i and attends keys 0..pos (clamped to
// n - 1); a nonzero window keeps only the recent window keys, so it
// attends max(0, pos + 1 - window)..pos (DFlash sliding attention).
// Scale is 1/sqrt(head_dim); head h reads kv head h / (heads/kv_heads).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer Q {
  float q[];
};

layout(set = 0, binding = 1) buffer K {
  float k[];
};

layout(set = 0, binding = 2) buffer V {
  float v[];
};

layout(set = 0, binding = 3) buffer Result {
  float values[];
};

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint heads = pc.v[4];
  uint kv_heads = pc.v[6];
  uint head_dim = pc.v[8];
  if (t >= m * heads * head_dim) {
    return;
  }
  uint i = t / (heads * head_dim);
  uint rem = t % (heads * head_dim);
  uint h = rem / head_dim;
  uint e = rem % head_dim;
  uint kv = h / (heads / kv_heads);
  // Positions fit 32 bits (contexts stay far below 4G tokens).
  uint window = pc.v[12];
  uint pos = pc.v[10] + i;
  uint last = pos >= n ? n - 1 : pos;
  uint start = (window != 0 && pos + 1 > window) ? pos + 1 - window : 0;
  if (start > last) {
    start = last;
  }
  float scale = inversesqrt(float(head_dim));
  uint q_base = (i * heads + h) * head_dim;
  float row_max = 0.0;
  bool first = true;
  // Two passes over an implicit score row (no shared scratch): max,
  // then the normalized weighted sum of v.
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * k[k_base + d];
    }
    dot *= scale;
    if (first || dot > row_max) {
      row_max = dot;
      first = false;
    }
  }
  float acc = 0.0;
  float denom = 0.0;
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * k[k_base + d];
    }
    float w = exp(dot * scale - row_max);
    denom += w;
    acc += w * v[k_base + e];
  }
  values[t] = acc / denom;
}
