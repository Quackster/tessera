#version 450

// One thread per output element; dispatch ceil(m * heads * head_dim / 256).
layout(local_size_x = 256) in;

// "attention_fp8" contract: buffer 0 is Q (fp32, m x heads*head_dim),
// buffer 1 K (packed OCP FP8 E4M3, n x kv_heads*head_dim), buffer 2 V
// (packed OCP FP8 E4M3), buffer 3 one fp32 K scale per key row, buffer 4
// one fp32 V scale per key row, buffer 5 the output (fp32). Scalars: m
// v[0], n v[2], heads v[4], kv_heads v[6], head_dim v[8], q_base v[10],
// window v[12].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer Q { float q[]; };
layout(set = 0, binding = 1) buffer K { uint k[]; };
layout(set = 0, binding = 2) buffer V { uint v[]; };
layout(set = 0, binding = 3) buffer KS { float ks[]; };
layout(set = 0, binding = 4) buffer VS { float vs[]; };
layout(set = 0, binding = 5) buffer Out { float out_values[]; };

// OCP FP8 E4M3 byte -> fp32 (port of the core Fp8E4M3ToFloat).
float fp8_e4m3_value(uint bits) {
  uint sign = bits >> 7;
  uint exp = (bits >> 3) & 0xFu;
  uint mant = bits & 0x7u;
  float value;
  if (exp == 0u) {
    value = float(mant) * exp2(-9.0);
  } else if (exp == 15u) {
    if (mant == 7u) {
      return sqrt(-1.0);  // NaN
    }
    value = (1.0 + float(mant) / 8.0) * 256.0;
  } else {
    value = (1.0 + float(mant) / 8.0) * exp2(float(int(exp) - 7));
  }
  return sign != 0u ? -value : value;
}

float k_byte(uint idx, float scale) {
  uint b = (k[idx >> 2] >> ((idx & 3u) << 3u)) & 0xFFu;
  return fp8_e4m3_value(b) * scale;
}

float v_byte(uint idx, float scale) {
  uint b = (v[idx >> 2] >> ((idx & 3u) << 3u)) & 0xFFu;
  return fp8_e4m3_value(b) * scale;
}

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint heads = pc.v[4];
  uint kv_heads = pc.v[6];
  uint head_dim = pc.v[8];
  if (t >= m * heads * head_dim) {
    return;
  }
  uint i = t / (heads * head_dim);
  uint rem = t % (heads * head_dim);
  uint h = rem / head_dim;
  uint e = rem % head_dim;
  uint kv = h / (heads / kv_heads);
  uint window = pc.v[12];
  uint pos = pc.v[10] + i;
  uint last = pos >= n ? n - 1 : pos;
  uint start = (window != 0 && pos + 1 > window) ? pos + 1 - window : 0;
  if (start > last) {
    start = last;
  }
  float scale = inversesqrt(float(head_dim));
  uint q_base = (i * heads + h) * head_dim;
  float row_max = 0.0;
  bool first = true;
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * k_byte(k_base + d, ks[j]);
    }
    dot *= scale;
    if (first || dot > row_max) {
      row_max = dot;
      first = false;
    }
  }
  float acc = 0.0;
  float denom = 0.0;
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * k_byte(k_base + d, ks[j]);
    }
    float w = exp(dot * scale - row_max);
    denom += w;
    acc += w * v_byte(k_base + e, vs[j]);
  }
  out_values[t] = acc / denom;
}
