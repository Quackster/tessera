#version 450

// One thread per output element; dispatch ceil(m * heads * head_dim / 256).
layout(local_size_x = 256) in;

// "attention_q4" contract: buffer 0 Q (fp32), buffer 1 K (packed 4-bit),
// buffer 2 V (packed 4-bit), buffer 3 K scale per key row, buffer 4 V
// scale per key row, buffer 5 output (fp32). Scalars: m v[0], n v[2],
// heads v[4], kv_heads v[6], head_dim v[8], q_base v[10], window v[12].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer Q { float q[]; };
layout(set = 0, binding = 1) buffer K { uint k[]; };
layout(set = 0, binding = 2) buffer V { uint v[]; };
layout(set = 0, binding = 3) buffer KS { float ks[]; };
layout(set = 0, binding = 4) buffer VS { float vs[]; };
layout(set = 0, binding = 5) buffer Out { float out_values[]; };

float nib(uint idx, uint word_src, float scale) {
  uint word = word_src;
  int n = int((word >> ((idx & 7u) << 2u)) & 0xFu);
  n = (n & 0x8) != 0 ? n - 16 : n;
  return float(n) * scale;
}

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint heads = pc.v[4];
  uint kv_heads = pc.v[6];
  uint head_dim = pc.v[8];
  if (t >= m * heads * head_dim) {
    return;
  }
  uint i = t / (heads * head_dim);
  uint rem = t % (heads * head_dim);
  uint h = rem / head_dim;
  uint e = rem % head_dim;
  uint kv = h / (heads / kv_heads);
  uint window = pc.v[12];
  uint pos = pc.v[10] + i;
  uint last = pos >= n ? n - 1 : pos;
  uint start = (window != 0 && pos + 1 > window) ? pos + 1 - window : 0;
  if (start > last) {
    start = last;
  }
  float scale = inversesqrt(float(head_dim));
  uint q_base = (i * heads + h) * head_dim;
  float row_max = 0.0;
  bool first = true;
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * nib(k_base + d, k[(k_base + d) >> 3], ks[j]);
    }
    dot *= scale;
    if (first || dot > row_max) {
      row_max = dot;
      first = false;
    }
  }
  float acc = 0.0;
  float denom = 0.0;
  for (uint j = start; j <= last; ++j) {
    uint k_base = (j * kv_heads + kv) * head_dim;
    float dot = 0.0;
    for (uint d = 0; d < head_dim; ++d) {
      dot += q[q_base + d] * nib(k_base + d, k[(k_base + d) >> 3], ks[j]);
    }
    float w = exp(dot * scale - row_max);
    denom += w;
    acc += w * nib(k_base + e, v[(k_base + e) >> 3], vs[j]);
  }
  out_values[t] = acc / denom;
}
