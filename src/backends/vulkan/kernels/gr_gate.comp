#version 450

// One 32-lane group per output element; the dispatch is ceil(hc_dim / 8)
// with local_size_x = 256 (8 groups). A group reads its weight row
// coalesced (lane k, k+32, ...) instead of one strided read per thread.
layout(local_size_x = 256) in;

// "gr_gate" contract: buffer 0 is lq (fp32, hc_lr), buffer 1 the bf16 up
// weight (hc*n_embd x hc_lr, two bytes each), buffer 2 the fp32 streams
// xn (hc*n_embd), buffer 3 the gated output (hc*n_embd). Scalars:
// hc_dim (v[0]), hc_lr (v[1]).
// gated[i] = xn[i] * sigmoid(lq @ w_up[i]).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer LQ { float lq[]; };
layout(set = 0, binding = 1) readonly buffer WU { uint wu[]; };
layout(set = 0, binding = 2) readonly buffer XN { float xn[]; };
layout(set = 0, binding = 3) writeonly buffer G { float gated[]; };

shared float part[8 * 32];
// Upper bound on the hyper-connection bottleneck (the model's low rank is
// 320), cached once per block so the block's groups do not each re-read lq.
shared float s_lq[512];

uint wbyte(uint off) {
  return (wu[off >> 2] >> ((off & 3) << 3)) & 0xFF;
}

float bf16_at(uint off) {
  uint h = wbyte(off) | (wbyte(off + 1) << 8);
  return uintBitsToFloat(h << 16);
}

float sigmoid(float x) { return 1.0 / (1.0 + exp(-x)); }

void main() {
  uint lane = gl_LocalInvocationID.x & 31u;
  uint group = gl_LocalInvocationID.x >> 5u;
  uint i = gl_WorkGroupID.x * 8u + group;
  uint hc_dim = pc.v[0];
  uint hc_lr = pc.v[2];
  for (uint k = gl_LocalInvocationID.x; k < hc_lr; k += 256u) {
    s_lq[k] = lq[k];
  }
  barrier();
  float acc = 0.0;
  if (i < hc_dim) {
    uint row = i * hc_lr;
    for (uint k = lane; k < hc_lr; k += 32u) {
      acc += s_lq[k] * bf16_at((row + k) * 2u);
    }
  }
  part[group * 32u + lane] = acc;
  barrier();
  if (lane == 0u && i < hc_dim) {
    float s = 0.0;
    for (uint j = 0u; j < 32u; ++j) {
      s += part[group * 32u + j];
    }
    gated[i] = xn[i] * sigmoid(s);
  }
}
