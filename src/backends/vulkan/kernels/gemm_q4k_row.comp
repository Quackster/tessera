#version 450

// Coalesced Q4_K GEMV: one workgroup per output element (row_a, row_w),
// so the weight and activation reads are coalesced across the workgroup
// instead of strided per thread. Thread t owns element `b * 256 + t` of
// every block: the activation read is 256 consecutive floats and the
// Q4_K byte read hits sub-block `t / 32` (lane `t % 32`). Partial sums
// reduce in shared memory. Dispatch is m * n workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_q4k_row" contract (tessera API): buffers and scalars match
// gemm_q4k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// Byte `offset` of the Q4_K buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact (port of the core
// Fp16ToFloat in src/core/numerics/quant.cpp).
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j from the 12-byte packing.
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);  // used only for j >= 4
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

shared float sh[256];

void main() {
  uint oidx = gl_WorkGroupID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  if (oidx >= m * n) {
    return;
  }
  uint row_a = oidx / n;
  uint row_w = oidx % n;
  uint blocks = k / 256u;
  uint t = gl_LocalInvocationID.x;
  uint s = t / 32u;
  uint lane = t % 32u;
  uint byte_off = 16u + (s / 2u) * 32u + lane;
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = row_w * (blocks * 144u) + b * 144u;
    float d = fp16_at(base);
    float dm = fp16_at(base + 2u);
    uint sc, mn;
    scale_min4(s, base, sc, mn);
    uint byte = wbyte(base + byte_off);
    uint nib = (s & 1u) == 0u ? (byte & 15u) : (byte >> 4u);
    float wv = d * float(sc) * float(nib) - dm * float(mn);
    acc += a[row_a * k + b * 256u + t] * wv;
  }
  sh[t] = acc;
  barrier();
  for (uint off = 128u; off > 0u; off >>= 1u) {
    if (t < off) {
      sh[t] += sh[t + off];
    }
    barrier();
  }
  if (t == 0u) {
    c[row_a * n + row_w] = sh[0];
  }
}
