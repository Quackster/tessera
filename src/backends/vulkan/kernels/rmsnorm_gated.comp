#version 450

// One workgroup per row (shared-memory sum reduction); the dispatch is
// `rows` workgroups of 256 via grid_x.
layout(local_size_x = 256) in;

// "rmsnorm_gated" contract: buffer 0 X (rows x cols), buffer 1 W
// (cols), buffer 2 the gate (rows x cols), buffer 3 the output Y.
// Scalars: rows v[0], cols v[2], epsilon fp32 bits v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer X {
  float x[];
};

layout(set = 0, binding = 1) buffer W {
  float w[];
};

layout(set = 0, binding = 2) buffer G {
  float g[];
};

layout(set = 0, binding = 3) buffer Y {
  float y[];
};

shared float red[256];

void main() {
  // One workgroup per row (shared-memory sum reduction).
  uint r = gl_WorkGroupID.x;
  uint rows = pc.v[0];
  if (r >= rows) {
    return;
  }
  uint cols = pc.v[2];
  float eps = uintBitsToFloat(pc.v[4]);
  uint tid = gl_LocalInvocationID.x;
  uint base = r * cols;
  float sum = 0.0;
  for (uint c = tid; c < cols; c += 256u) {
    sum = fma(x[base + c], x[base + c], sum);
  }
  red[tid] = sum;
  barrier();
  for (uint st = 128u; st > 0u; st >>= 1u) {
    if (tid < st) {
      red[tid] += red[tid + st];
    }
    barrier();
  }
  float mean = red[0] / float(cols);
  float gain = 1.0 / sqrt(mean + eps);
  for (uint c = tid; c < cols; c += 256u) {
    float gate = g[base + c];
    float silu = gate / (1.0 + exp(-gate));
    y[base + c] = x[base + c] * gain * w[c] * silu;
  }
}
