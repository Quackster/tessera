#version 450

// One thread per row; the dispatch is ceil(rows / 256) workgroups
// via grid_x.
layout(local_size_x = 256) in;

// "rmsnorm_gated" contract: buffer 0 X (rows x cols), buffer 1 W
// (cols), buffer 2 the gate (rows x cols), buffer 3 the output Y.
// Scalars: rows v[0], cols v[2], epsilon fp32 bits v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer X {
  float x[];
};

layout(set = 0, binding = 1) buffer W {
  float w[];
};

layout(set = 0, binding = 2) buffer G {
  float g[];
};

layout(set = 0, binding = 3) buffer Y {
  float y[];
};

void main() {
  uint r = gl_GlobalInvocationID.x;
  uint rows = pc.v[0];
  if (r >= rows) {
    return;
  }
  uint cols = pc.v[2];
  float eps = uintBitsToFloat(pc.v[4]);
  float mean = 0.0;
  for (uint c = 0; c < cols; ++c) {
    mean += x[r * cols + c] * x[r * cols + c];
  }
  mean /= float(cols);
  float gain = inversesqrt(mean + eps);
  for (uint c = 0; c < cols; ++c) {
    float gate = g[r * cols + c];
    float silu = gate / (1.0 + exp(-gate));
    y[r * cols + c] = x[r * cols + c] * gain * w[c] * silu;
  }
}
