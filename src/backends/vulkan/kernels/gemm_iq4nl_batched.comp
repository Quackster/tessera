#version 450

// Tiled batched IQ4_NL GEMM: one workgroup covers 32 activation rows x 8
// weight columns with one thread per output. A block is 18 bytes: d fp16
// then 16 nibble bytes; the element order matches the scalar gemm_iq4nl.
// Dispatch is ceil(m / 32) * ceil(n / 8) workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_iq4nl_batched" contract (tessera API): buffers and scalars match
// gemm_iq4nl (m, n, k, k a multiple of 32). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

// IQ4 codebook (ports kvalues_iq4nl).
const int kValues[16] =
    int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53,
             69, 89, 113);

// Byte `offset` of the weight buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 7u) / 8u;
  uint wg = gl_WorkGroupID.x;
  uint row_a = (wg / col_tiles) * 32u + tid / 8u;
  uint row_w = (wg % col_tiles) * 8u + tid % 8u;
  if (row_a >= m || row_w >= n) {
    return;
  }
  uint blocks = k / 32u;
  uint abase = row_a * k;
  uint wbase = row_w * (blocks * 18u);
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = wbase + b * 18u;
    float d = fp16_at(base);
    for (uint j = 0u; j < 16u; ++j) {
      uint q = wbyte(base + 2u + j);
      acc += a[abase + b * 32u + j] * (d * float(kValues[q & 15u]));
      acc += a[abase + b * 32u + j + 16u] * (d * float(kValues[q >> 4u]));
    }
  }
  c[row_a * n + row_w] = acc;
}
