#version 450

// Tiled batched IQ4_NL GEMM: one workgroup covers 32 activation rows x 32
// weight columns over 1024 threads. A block is 18 bytes (d fp16 then 16
// nibble bytes); eight blocks form one 256-element tile that is
// dequantized once into shared memory and reused across the 32 rows. The
// element order matches the scalar gemm_iq4nl. Dispatch is ceil(m / 32) *
// ceil(n / 32) workgroups of 1024.
layout(local_size_x = 1024) in;

// "gemm_iq4nl_batched" contract (tessera API): buffers and scalars match
// gemm_iq4nl (m, n, k, k a multiple of 32). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

shared float tile[8192];

// IQ4 codebook (ports kvalues_iq4nl).
const int kValues[16] =
    int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53,
             69, 89, 113);

// Byte `offset` of the weight buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 31u) / 32u;
  uint wg = gl_WorkGroupID.x;
  uint row_base = (wg / col_tiles) * 32u;
  uint col_base = (wg % col_tiles) * 32u;
  uint my_row = tid / 32u;
  uint my_col = tid % 32u;
  uint row_a = row_base + my_row;
  uint row_w = col_base + my_col;
  bool has_out = row_a < m && row_w < n;
  uint blocks = k / 32u;
  float acc = 0.0;
  uint pair = tid >> 2u;
  uint col = pair & 31u;
  uint sub = (pair >> 5u) & 7u;
  uint lane0 = (tid & 3u) * 8u;
  uint gc = col_base + col;
  for (uint bb = 0u; bb < blocks; bb += 8u) {
    uint subs = blocks - bb < 8u ? blocks - bb : 8u;
    if (gc < n && sub < subs) {
      uint base = gc * (blocks * 18u) + (bb + sub) * 18u;
      float d = fp16_at(base);
      for (uint kk = 0u; kk < 8u; ++kk) {
        uint lane = lane0 + kk;
        uint q = wbyte(base + 2u + (lane & 15u));
        uint nib = lane < 16u ? (q & 15u) : (q >> 4u);
        tile[(sub * 32u + lane) * 32u + col] = d * float(kValues[nib]);
      }
    }
    barrier();
    if (has_out) {
      uint abase = row_a * k + bb * 32u;
      for (uint sub = 0u; sub < subs; ++sub) {
        for (uint l = 0u; l < 16u; ++l) {
          uint lo = sub * 32u + l;
          uint hi = lo + 16u;
          acc += a[abase + lo] * tile[lo * 32u + my_col];
          acc += a[abase + hi] * tile[hi * 32u + my_col];
        }
      }
    }
    barrier();
  }
  if (has_out) {
    c[row_a * n + row_w] = acc;
  }
}
