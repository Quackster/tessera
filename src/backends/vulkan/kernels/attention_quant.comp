#version 450

// One workgroup per (query row, head); the query is staged in shared
// memory and the tile runs an online softmax, so the dot product is
// computed once per key: O(n * head_dim) per query/head.
layout(local_size_x = 256) in;

// "attention_q8"/"attention_q4"/"attention_fp8" contract: buffer 0 is Q
// (fp32, m x heads*head_dim), buffer 1 K, buffer 2 V (packed quantized
// bytes, four per uint for int8 and FP8, eight per uint for 4-bit), buffer
// 3 one fp32 K scale per key row, buffer 4 one fp32 V scale per key row,
// buffer 5 the output (fp32). Scalars: m v[0], n v[2], heads v[4],
// kv_heads v[6], head_dim v[8], q_base v[10], row_base v[12], window v[14],
// kind v[16] (0 int8, 1 4-bit, 2 OCP FP8 E4M3). row_base offsets the
// q/out row index, so one launch can serve one sequence's rows inside a
// shared multi-sequence batch.
layout(push_constant) uniform PushConstants {
  uint v[24];
} pc;

layout(set = 0, binding = 0) buffer Q { float q[]; };
layout(set = 0, binding = 1) buffer K { uint k[]; };
layout(set = 0, binding = 2) buffer V { uint v[]; };
layout(set = 0, binding = 3) buffer KS { float ks[]; };
layout(set = 0, binding = 4) buffer VS { float vs[]; };
layout(set = 0, binding = 5) buffer Out { float out_values[]; };

shared float q_s[256];
shared float sc[256];
shared float wt[256];
shared float red[256];
shared float tile_bc[3];

// OCP FP8 E4M3 byte -> fp32 (port of the core Fp8E4M3ToFloat).
float fp8_e4m3_value(uint bits) {
  uint sign = bits >> 7;
  uint exp = (bits >> 3) & 0xFu;
  uint mant = bits & 0x7u;
  float value;
  if (exp == 0u) {
    value = float(mant) * exp2(-9.0);
  } else if (exp == 15u) {
    if (mant == 7u) {
      return sqrt(-1.0);  // NaN
    }
    value = (1.0 + float(mant) / 8.0) * 256.0;
  } else {
    value = (1.0 + float(mant) / 8.0) * exp2(float(int(exp) - 7));
  }
  return sign != 0u ? -value : value;
}

// Decode element `idx` of a quantized K/V row with per-row scale `s`.
float kv_at(uint kind, uint idx, float s) {
  if (kind == 1u) {
    uint word = k[idx >> 3];
    int value = int((word >> ((idx & 7u) << 2u)) & 0xFu);
    if ((value & 0x8) != 0) {
      value -= 16;
    }
    return float(value) * s;
  }
  uint b = (k[idx >> 2] >> ((idx & 3u) << 3u)) & 0xFFu;
  if (kind == 0u) {
    int value = int(b);
    if ((value & 0x80) != 0) {
      value -= 256;
    }
    return float(value) * s;
  }
  return fp8_e4m3_value(b) * s;
}

float kv_at_v(uint kind, uint idx, float s) {
  if (kind == 1u) {
    uint word = v[idx >> 3];
    int value = int((word >> ((idx & 7u) << 2u)) & 0xFu);
    if ((value & 0x8) != 0) {
      value -= 16;
    }
    return float(value) * s;
  }
  uint b = (v[idx >> 2] >> ((idx & 3u) << 3u)) & 0xFFu;
  if (kind == 0u) {
    int value = int(b);
    if ((value & 0x80) != 0) {
      value -= 256;
    }
    return float(value) * s;
  }
  return fp8_e4m3_value(b) * s;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint heads = pc.v[4];
  uint kv_heads = pc.v[6];
  uint head_dim = pc.v[8];
  uint q_base = pc.v[10];
  uint row_base = pc.v[12];
  uint window = pc.v[14];
  uint kind = pc.v[16];
  uint g = gl_WorkGroupID.x;
  if (g >= m * heads) {
    return;
  }
  uint e = gl_LocalInvocationID.x;
  uint i = g / heads;
  uint h = g % heads;
  uint kv = h / (heads / kv_heads);
  uint pos = q_base + i;
  uint last = pos >= n ? n - 1 : pos;
  uint start = (window != 0u && pos + 1u > window) ? pos + 1u - window : 0u;
  if (start > last) {
    start = last;
  }
  float scale = inversesqrt(float(head_dim));
  uint qb = ((row_base + i) * heads + h) * head_dim;
  if (e < head_dim) {
    q_s[e] = q[qb + e];
  }
  barrier();
  float run_max = -1e30;
  float run_sum = 0.0;
  float acc = 0.0;
  uint tile = start;
  while (true) {
    uint tile_last = (tile + 255u < last) ? tile + 255u : last;
    float s = -1e30;
    if (tile + e <= last) {
      uint j = tile + e;
      uint kb = (j * kv_heads + kv) * head_dim;
      // Four independent partial sums keep the FMA pipeline full.
      float dot0 = 0.0, dot1 = 0.0, dot2 = 0.0, dot3 = 0.0;
      uint d = 0u;
      for (; d + 3u < head_dim; d += 4u) {
        dot0 += q_s[d] * kv_at(kind, kb + d, ks[j]);
        dot1 += q_s[d + 1u] * kv_at(kind, kb + d + 1u, ks[j]);
        dot2 += q_s[d + 2u] * kv_at(kind, kb + d + 2u, ks[j]);
        dot3 += q_s[d + 3u] * kv_at(kind, kb + d + 3u, ks[j]);
      }
      float dot = (dot0 + dot1) + (dot2 + dot3);
      for (; d < head_dim; ++d) {
        dot += q_s[d] * kv_at(kind, kb + d, ks[j]);
      }
      s = dot * scale;
    }
    sc[e] = s;
    barrier();
    // Parallel tile softmax: the run max takes an order-free fold, every
    // thread exps its own score, and thread 0 keeps the ordered sum.
    if (e < 16u) {
      float tmax = sc[e * 16u];
      for (uint t = 1u; t < 16u; ++t) {
        tmax = max(tmax, sc[e * 16u + t]);
      }
      red[e] = tmax;
    }
    barrier();
    if (e < 8u) {
      red[e] = max(red[e], red[e + 8u]);
    }
    barrier();
    if (e < 4u) {
      red[e] = max(red[e], red[e + 4u]);
    }
    barrier();
    if (e < 2u) {
      red[e] = max(red[e], red[e + 2u]);
    }
    barrier();
    if (e == 0u) {
      tile_bc[0] = max(run_max, max(red[0], red[1u]));
      tile_bc[1] = exp(run_max - tile_bc[0]);
    }
    barrier();
    wt[e] = exp(sc[e] - tile_bc[0]);
    barrier();
    if (e == 0u) {
      // Four ordered chains keep the sequential partial sums.
      float l0 = 0.0, l1 = 0.0, l2 = 0.0, l3 = 0.0;
      for (uint t = 0u; t < 256u; t += 4u) {
        l0 += wt[t];
        l1 += wt[t + 1u];
        l2 += wt[t + 2u];
        l3 += wt[t + 3u];
      }
      tile_bc[2] = (l0 + l1) + (l2 + l3);
    }
    barrier();
    float m_new = tile_bc[0];
    float corr = tile_bc[1];
    float l = tile_bc[2];
    // Four independent accumulators, as in the score dot above.
    float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
    float a = 0.0;
    if (e < head_dim) {
      uint count = (tile + 255u <= last) ? 256u : (last - tile + 1u);
      uint t = 0u;
      for (; t + 3u < count; t += 4u) {
        uint b0 = (tile + t) * kv_heads + kv;
        uint b1 = (tile + t + 1u) * kv_heads + kv;
        uint b2 = (tile + t + 2u) * kv_heads + kv;
        uint b3 = (tile + t + 3u) * kv_heads + kv;
        a0 += wt[t] * kv_at_v(kind, b0 * head_dim + e, vs[tile + t]);
        a1 += wt[t + 1u] * kv_at_v(kind, b1 * head_dim + e, vs[tile + t + 1u]);
        a2 += wt[t + 2u] * kv_at_v(kind, b2 * head_dim + e, vs[tile + t + 2u]);
        a3 += wt[t + 3u] * kv_at_v(kind, b3 * head_dim + e, vs[tile + t + 3u]);
      }
      a = (a0 + a1) + (a2 + a3);
      for (; t < count; ++t) {
        uint vb = (tile + t) * kv_heads + kv;
        a += wt[t] * kv_at_v(kind, vb * head_dim + e, vs[tile + t]);
      }
    }
    acc = corr * acc + a;
    run_sum = corr * run_sum + l;
    run_max = m_new;
    barrier();
    if (tile_last >= last) {
      break;
    }
    tile += 256u;
  }
  if (e < head_dim) {
    out_values[qb + e] = acc / run_sum;
  }
}
