#version 450

// One thread per output element; dispatch ceil(rows * cols / 256).
layout(local_size_x = 256) in;

// "embedding_q4k" contract (tessera API): buffer 0 is the token ids
// (u32, rows), buffer 1 the Q4_K embedding table (vocab x cols),
// buffer 2 the output (rows x cols fp32). Scalars are 64-bit, so field
// rows lives at pc.v[0], cols at pc.v[2], vocab at pc.v[4]. Row t of
// the table starts at element t * cols. An out-of-range id writes a
// zero row.
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer Ids { uint ids[]; };

// Q4_K blocks are 144 bytes (a multiple of 4), so the whole table can
// be viewed as uint words; bytes are extracted with a shift and mask.
layout(set = 0, binding = 1) buffer W { uint w[]; };
layout(set = 0, binding = 2) buffer O { float o[]; };

// Byte `offset` of the Q4_K table (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact (port of the core
// Fp16ToFloat in src/core/numerics/quant.cpp).
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j from the 12-byte packing
// (port of the core GetScaleMin; the rocm kernel uses the same
// formula). `base` is the byte offset of the block header.
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);  // used only for j >= 4
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

void main() {
  uint g = gl_GlobalInvocationID.x;
  uint rows = pc.v[0];
  uint cols = pc.v[2];
  uint vocab = pc.v[4];
  if (g >= rows * cols) {
    return;
  }
  uint row = g / cols;
  uint i = g % cols;
  uint id = ids[row];
  if (id >= vocab) {
    o[g] = 0.0;
    return;
  }
  uint blocks = cols / 256;
  uint b = i / 256;
  uint e = i % 256;
  uint base = id * (blocks * 144) + b * 144;
  float d = fp16_at(base);
  float dm = fp16_at(base + 2);
  uint grp = e / 64;
  uint hi = (e % 64) / 32;
  uint l = e % 32;
  uint sc, mn;
  scale_min4(grp * 2 + hi, base, sc, mn);
  uint q = wbyte(base + 16 + grp * 32 + l);
  uint nib = hi == 0 ? (q & 15) : (q >> 4);
  o[g] = d * float(sc) * float(nib) - dm * float(mn);
}
