#version 450

// Warp-per-output IQ4_XS GEMV; see gemm_q4k_vec for the launch contract.
// Lane l owns sub-block ib = l/4 and its four nibble bytes at
// jj = (l%4)*4: elements ib*32+jj..+3 (low nibbles) and +16 (high
// nibbles), with the sub-block's 6-bit scale.
layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// IQ4 codebook (ports kvalues_iq4nl).
const int kValues[16] =
    int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53,
             69, 89, 113);

uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

shared float sh[256];

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint split = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= m * n) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint ib = lane / 4u;
  uint jj = (lane & 3u) * 4u;
  uint blocks = k / 256u;
  uint per = blocks / split;
  uint b0 = gl_WorkGroupID.y * per;
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint w_base = row_w * (blocks * 136u);
  float acc = 0.0;
  for (uint b = b0; b < b0 + per; ++b) {
    uint base = w_base + b * 136u;
    float d = fp16_at(base);
    uint scales_h = wbyte(base + 2u) | (wbyte(base + 3u) << 8);
    uint packed = wbyte(base + 4u + ib / 2u);
    int ls = int((packed >> (4u * (ib & 1u))) & 15u) |
             (int((scales_h >> (2u * ib)) & 3u) << 4);
    float dl = d * float(ls - 32);
    uint t = b * 256u + ib * 32u + jj;
    for (uint j = 0u; j < 4u; ++j) {
      uint q = wbyte(base + 8u + ib * 16u + jj + j);
      acc += a[row_a * k + t + j] * (dl * float(kValues[q & 15u]));
      acc += a[row_a * k + t + 16u + j] * (dl * float(kValues[q >> 4]));
    }
  }
  uint t = gl_LocalInvocationID.x;
  sh[t] = acc;
  barrier();
  for (uint off = 16u; off > 0u; off >>= 1u) {
    if ((t & 31u) < off) {
      sh[t] += sh[t + off];
    }
    barrier();
  }
  if (lane == 0u) {
    c[gl_WorkGroupID.y * (m * n) + idx] = sh[t];
  }
}
