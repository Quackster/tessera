#version 450

// Warp-per-output Q4_K GEMV ("gemm_q4k_vec" contract): one 32-lane group
// per output element, eight groups per 256-thread workgroup, grid_x =
// ceil(m n / 8) and grid_y = the split-K chunk. Lane l owns byte l of
// each of the four 32-byte qs groups; the low nibble is element
// g*64+l and the high nibble is g*64+l+32, with sub-block scales
// (2g, 2g+1). split == 1 writes the output; a split > 1 writes its
// partial to region `grid_y` of C for "gemm_vec_reduce". The per-group
// shared reduction mirrors the ROCm shuffle tree (same association).

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

shared float sh[256];

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint split = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= m * n) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint blocks = k / 256u;
  uint per = blocks / split;
  uint b0 = gl_WorkGroupID.y * per;
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint w_base = row_w * (blocks * 144u);
  float acc = 0.0;
  for (uint b = b0; b < b0 + per; ++b) {
    uint base = w_base + b * 144u;
    float d = fp16_at(base);
    float dm = fp16_at(base + 2u);
    for (uint g = 0u; g < 4u; ++g) {
      uint sc0, mn0, sc1, mn1;
      scale_min4(g * 2u, base, sc0, mn0);
      scale_min4(g * 2u + 1u, base, sc1, mn1);
      uint q = wbyte(base + 16u + g * 32u + lane);
      uint t = b * 256u + g * 64u + lane;
      acc += a[row_a * k + t] *
             (d * float(sc0) * float(q & 15u) - dm * float(mn0));
      acc += a[row_a * k + t + 32u] *
             (d * float(sc1) * float(q >> 4) - dm * float(mn1));
    }
  }
  uint t = gl_LocalInvocationID.x;
  sh[t] = acc;
  barrier();
  for (uint off = 16u; off > 0u; off >>= 1u) {
    if ((t & 31u) < off) {
      sh[t] += sh[t + off];
    }
    barrier();
  }
  if (lane == 0u) {
    c[gl_WorkGroupID.y * (m * n) + idx] = sh[t];
  }
}
