#version 450

// One thread per (row, value head); dispatch ceil(rows * heads / 256).
layout(local_size_x = 256) in;

// "ssm_gate" contract: buffers are a_log, dt (fp32, heads each),
// alpha_raw, beta_raw, alpha_out, beta_out (fp32, rows x heads). Scalars
// are heads v[0] and rows v[2].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer ALog { float a_log[]; };
layout(set = 0, binding = 1) buffer Dt { float dt[]; };
layout(set = 0, binding = 2) buffer AlphaRaw { float alpha_raw[]; };
layout(set = 0, binding = 3) buffer BetaRaw { float beta_raw[]; };
layout(set = 0, binding = 4) buffer Alpha { float alpha[]; };
layout(set = 0, binding = 5) buffer Beta { float beta[]; };

void main() {
  uint t = gl_GlobalInvocationID.x;
  uint heads = pc.v[0];
  uint rows = pc.v[2];
  if (t >= rows * heads) {
    return;
  }
  uint h = t % heads;
  float raw = alpha_raw[t] + dt[h];
  float softplus = raw > 20.0 ? raw : log(1.0 + exp(raw));
  alpha[t] = exp(a_log[h] * softplus);
  beta[t] = 1.0 / (1.0 + exp(-beta_raw[t]));
}
