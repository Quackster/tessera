#version 450

// Mixture-of-experts gating for one token. One workgroup of 256 threads.
// It computes the softmax weights over the selected experts and the
// shared-expert gate from the normed hidden and the shared-expert weight.
layout(local_size_x = 256) in;

// "moe_gate" contract: buffers Vals (top_k fp32, the selected router
// logits), X (hidden fp32, the normed input), ShexpW (hidden fp32),
// Wts (top_k fp32 output), Sig (1 fp32 output). Wts = softmax(Vals);
// Sig = sigmoid(dot(X, ShexpW)). Scalars: top_k v[0], hidden v[2].
// (The top-k renormalized softmax equals the renormalized softmax over all
// experts, so the full logit vector is not needed here.)
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer Vals { float vals[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) readonly buffer ShexpW { float w[]; };
layout(set = 0, binding = 3) writeonly buffer Wts { float wts[]; };
layout(set = 0, binding = 4) writeonly buffer Sig { float sig[]; };

shared float red[256];

void main() {
  uint top_k = pc.v[0];
  uint hidden = pc.v[2];
  uint tid = gl_LocalInvocationID.x;
  float dot = 0.0;
  for (uint t = tid; t < hidden; t += 256u) {
    dot += x[t] * w[t];
  }
  red[tid] = dot;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (tid < s) {
      red[tid] += red[tid + s];
    }
    barrier();
  }
  if (tid == 0u) {
    float m = -3.402823466e+38;
    for (uint p = 0u; p < top_k; ++p) {
      m = max(m, vals[p]);
    }
    float sum = 0.0;
    for (uint p = 0u; p < top_k; ++p) {
      sum += exp(vals[p] - m);
    }
    for (uint p = 0u; p < top_k; ++p) {
      wts[p] = exp(vals[p] - m) / sum;
    }
    sig[0] = 1.0 / (1.0 + exp(-red[0]));
  }
}
