#version 450

// Mixture-of-experts gating for one token. One workgroup of 256 threads.
// The router logits are already reduced to the top-k (ids and vals); this
// kernel turns the full logit vector into softmax weights over the selected
// experts and applies the shared-expert gate.
layout(local_size_x = 256) in;

// "moe_gate" contract: buffers Logits (ne fp32), Vals (top_k fp32, the
// selected logits), Gate (1 fp32, the shared-expert logit), Wts (top_k fp32
// output), Sig (1 fp32 output). Wts[p] = exp(Vals[p] - max) / sum(exp(l - max))
// over all ne logits; when the renormalize flag is set Wts is divided by its
// own sum. Sig = sigmoid(Gate[0]). Scalars: ne v[0], top_k v[2], renorm v[4].
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer Logits { float logits[]; };
layout(set = 0, binding = 1) readonly buffer Vals { float vals[]; };
layout(set = 0, binding = 2) readonly buffer Gate { float gate[]; };
layout(set = 0, binding = 3) buffer Wts { float wts[]; };
layout(set = 0, binding = 4) writeonly buffer Sig { float sig[]; };

shared float red[256];

const float kNegInf = -3.402823466e+38;

void main() {
  uint ne = pc.v[0];
  uint top_k = pc.v[2];
  uint renorm = pc.v[4];
  uint tid = gl_LocalInvocationID.x;

  float m = kNegInf;
  for (uint c = tid; c < ne; c += 256u) {
    m = max(m, logits[c]);
  }
  red[tid] = m;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (tid < s) {
      red[tid] = max(red[tid], red[tid + s]);
    }
    barrier();
  }
  float maxv = red[0];
  barrier();

  float sum = 0.0;
  for (uint c = tid; c < ne; c += 256u) {
    sum += exp(logits[c] - maxv);
  }
  red[tid] = sum;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (tid < s) {
      red[tid] += red[tid + s];
    }
    barrier();
  }
  float denom = red[0];

  if (tid == 0u) {
    float total = 0.0;
    for (uint p = 0u; p < top_k; ++p) {
      float w = exp(vals[p] - maxv) / denom;
      wts[p] = w;
      total += w;
    }
    if (renorm != 0u && total > 0.0) {
      for (uint p = 0u; p < top_k; ++p) {
        wts[p] = wts[p] / total;
      }
    }
    sig[0] = 1.0 / (1.0 + exp(-gate[0]));
  }
}
