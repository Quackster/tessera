#version 450

// Small-batch bf16 GEMV, the Vulkan twin of GemmBf16RowsKernel. One warp
// owns one weight column (row_w) and accumulates every one of the m
// activation rows, so the weight column is read once per column. Grid:
// ceil(n / 8) workgroups of 256. m is 1..16.
layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};
layout(set = 0, binding = 1) buffer W {
  uint w[];
};
layout(set = 0, binding = 2) buffer C {
  float c[];
};

// bf16 -> fp32: shift the 16 bits into the high half of an fp32 word.
float bf16_at(uint index) {
  uint word = w[index >> 1];
  uint bits = (word >> ((index & 1) << 4)) & 0xFFFF;
  return uintBitsToFloat(bits << 16);
}

shared float red[256];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint lane = lid & 31u;
  uint group = lid >> 5u;
  uint warp = (gl_WorkGroupID.x * 256u + lid) / 32u;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  // Every thread must reach the barriers below, so an out-of-range warp stays
  // in the loop and only skips the store.
  bool valid = warp < n;
  uint row_w = valid ? warp : 0u;
  uint rows = min(m, 16u);
  float acc[16];
  for (uint r = 0u; r < 16u; ++r) {
    acc[r] = 0.0;
  }
  for (uint t = lane; t < k; t += 32u) {
    float wt = bf16_at(row_w * k + t);
    for (uint r = 0u; r < rows; ++r) {
      acc[r] = fma(a[r * k + t], wt, acc[r]);
    }
  }
  for (uint r = 0u; r < rows; ++r) {
    red[lid] = acc[r];
    barrier();
    if (lane == 0u && valid) {
      float sum = 0.0;
      for (uint i = 0u; i < 32u; ++i) {
        sum += red[group * 32u + i];
      }
      c[r * n + row_w] = sum;
    }
    barrier();
  }
}
