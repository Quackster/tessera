#version 450

// One workgroup per row. The dispatch grid is the row count; the workgroup
// reduces the row absmax together and writes the packed codes in parallel.
layout(local_size_x = 256) in;

// "quantize_q4" contract: buffer 0 is In (fp32, rows x cols), buffer 1 the
// output (packed 4-bit, rows x cols/2 bytes, eight per uint), buffer 2 one
// fp32 scale per row. Scalars: rows v[0], cols v[2] (multiple of 8); grid
// is the row count, one workgroup per row.
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer In { float a[]; };
layout(set = 0, binding = 1) buffer Out { uint packed[]; };
layout(set = 0, binding = 2) buffer Scale { float scale[]; };

shared float red[256];

int round_away(float x) {
  return x >= 0.0 ? int(floor(x + 0.5)) : int(ceil(x - 0.5));
}

void main() {
  uint r = gl_WorkGroupID.x;
  uint rows = pc.v[0];
  uint cols = pc.v[2];
  if (r >= rows) {
    return;
  }
  uint tid = gl_LocalInvocationID.x;
  uint base = r * cols;
  float amax = 0.0;
  for (uint c = tid; c < cols; c += 256u) {
    amax = max(amax, abs(a[base + c]));
  }
  red[tid] = amax;
  for (uint s = 128u; s > 0u; s >>= 1u) {
    barrier();
    if (tid < s) {
      red[tid] = max(red[tid], red[tid + s]);
    }
  }
  barrier();
  float sc = red[0] > 0.0 ? red[0] / 7.0 : 1.0;
  if (tid == 0u) {
    scale[r] = sc;
  }
  uint words = cols / 8u;
  for (uint w = tid; w < words; w += 256u) {
    uint word = 0u;
    for (uint b = 0u; b < 8u; ++b) {
      int q = round_away(a[base + w * 8u + b] / sc);
      q = clamp(q, -7, 7);
      word |= (uint(q) & 0xFu) << (b * 4u);
    }
    packed[r * words + w] = word;
  }
}
