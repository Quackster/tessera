#version 450

// One thread per row.
layout(local_size_x = 256) in;

// "quantize_q4" contract: buffer 0 is In (fp32, rows x cols), buffer 1 the
// output (packed 4-bit, rows x cols/2 bytes, eight per uint), buffer 2 one
// fp32 scale per row. Scalars: rows v[0], cols v[2] (multiple of 8).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) buffer In { float a[]; };
layout(set = 0, binding = 1) buffer Out { uint packed[]; };
layout(set = 0, binding = 2) buffer Scale { float scale[]; };

int round_away(float x) {
  return x >= 0.0 ? int(floor(x + 0.5)) : int(ceil(x - 0.5));
}

void main() {
  uint r = gl_GlobalInvocationID.x;
  uint rows = pc.v[0];
  uint cols = pc.v[2];
  if (r >= rows) {
    return;
  }
  uint base = r * cols;
  float amax = 0.0;
  for (uint c = 0; c < cols; ++c) {
    amax = max(amax, abs(a[base + c]));
  }
  float s = amax > 0.0 ? amax / 7.0 : 1.0;
  scale[r] = s;
  uint words = cols / 8u;
  for (uint w = 0; w < words; ++w) {
    uint word = 0u;
    for (uint b = 0u; b < 8u; ++b) {
      int q = round_away(a[base + w * 8u + b] / s);
      q = clamp(q, -7, 7);
      word |= (uint(q) & 0xFu) << (b * 4u);
    }
    packed[r * words + w] = word;
  }
}
