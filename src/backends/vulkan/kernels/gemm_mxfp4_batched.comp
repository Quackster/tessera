#version 450

// Tiled batched MXFP4 GEMM: one workgroup covers 32 activation rows x 32
// weight columns over 1024 threads. Eight 32-element blocks form one
// 256-element tile that is dequantized once into shared memory and reused
// across the 32 rows. Each thread keeps four partial sums (one per
// 8-element word) so the FMA chain stays shallow, matching the gemm_mxfp4
// order. Dispatch is ceil(m / 32) * ceil(n / 32) workgroups of 1024.
layout(local_size_x = 1024) in;

// "gemm_mxfp4_batched" contract (tessera API): buffers and scalars match
// gemm_mxfp4 (m, n, k, k a multiple of 32). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

shared float tile[8192];

// Byte `offset` of the packed weight buffer viewed as uint words.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// OCP MX E2M1 nibble values (port of the core F4E2M1ToFloat).
const float kE2M1[16] = float[16](
    0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0);

void main() {
  uint tid = gl_LocalInvocationID.x;
  uint wg = gl_WorkGroupID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint col_tiles = (n + 31u) / 32u;
  uint row_base = (wg / col_tiles) * 32u;
  uint col_base = (wg % col_tiles) * 32u;
  uint my_row = tid / 32u;
  uint my_col = tid % 32u;
  uint row_a = row_base + my_row;
  uint row_w = col_base + my_col;
  bool has_out = row_a < m && row_w < n;
  uint blocks = k / 32u;
  uint scale_base = (n * k) >> 1;
  float p0 = 0.0;
  float p1 = 0.0;
  float p2 = 0.0;
  float p3 = 0.0;
  uint pair = tid >> 2u;
  uint col = pair & 31u;
  uint sub = (pair >> 5u) & 7u;
  uint lane0 = (tid & 3u) * 8u;
  uint gc = col_base + col;
  uint qq = lane0 >> 3u;
  for (uint bb = 0u; bb < blocks; bb += 8u) {
    uint subs = blocks - bb < 8u ? blocks - bb : 8u;
    if (gc < n && sub < subs) {
      uint wqr = (gc * k) >> 3u;
      uint word = w[wqr + (bb + sub) * 4u + qq];
      float scale = exp2(float(wbyte(scale_base + gc * blocks + bb + sub)) - 127.0);
      for (uint jj = 0u; jj < 8u; ++jj) {
        uint nib = (word >> (4u * jj)) & 15u;
        tile[(sub * 32u + qq * 8u + jj) * 32u + col] = scale * kE2M1[nib];
      }
    }
    barrier();
    if (has_out) {
      uint abase = row_a * k + bb * 32u;
      for (uint sub = 0u; sub < subs; ++sub) {
        for (uint jj = 0u; jj < 8u; ++jj) {
          uint tbase = (sub * 32u + jj) * 32u + my_col;
          p0 = fma(a[abase + sub * 32u + jj], tile[tbase], p0);
          p1 = fma(a[abase + sub * 32u + 8u + jj], tile[tbase + 8u * 32u], p1);
          p2 = fma(a[abase + sub * 32u + 16u + jj], tile[tbase + 16u * 32u], p2);
          p3 = fma(a[abase + sub * 32u + 24u + jj], tile[tbase + 24u * 32u], p3);
        }
      }
    }
    barrier();
  }
  if (has_out) {
    c[row_a * n + row_w] = (p0 + p1) + (p2 + p3);
  }
}
