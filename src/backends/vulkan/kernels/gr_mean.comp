#version 450

// One thread per output element; the dispatch is ceil(n_embd / 256).
layout(local_size_x = 256) in;

// "gr_mean" contract: buffer 0 is gated (fp32, hc*n_embd), buffer 1 the
// mixed output (fp32, n_embd). Scalars: n_embd (v[0]), hc (v[1]).
layout(push_constant) uniform PushConstants {
  uint v[16];
} pc;

layout(set = 0, binding = 0) readonly buffer G { float gated[]; };
layout(set = 0, binding = 1) writeonly buffer M { float mixed[]; };

void main() {
  uint d = gl_GlobalInvocationID.x;
  uint n_embd = pc.v[0];
  uint hc = pc.v[2];
  if (d >= n_embd) {
    return;
  }
  float m = 0.0;
  for (uint c = 0u; c < hc; ++c) {
    m += gated[c * n_embd + d];
  }
  mixed[d] = m / float(hc);
}
