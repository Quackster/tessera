#version 450

// Tiled batched Q6_K GEMM: one workgroup covers 32 activation rows x 32
// weight columns over 1024 threads. Each 256-element block is dequantized
// once into shared memory and reused across the 32 rows. The dot keeps
// the gemm_q6k order. Dispatch is ceil(m / 32) * ceil(n / 32) workgroups
// of 1024.
layout(local_size_x = 1024) in;

// "gemm_q6k_batched" contract (tessera API): buffers and scalars match
// gemm_q6k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

shared float tile[8192];

// Byte `offset` of the Q6_K buffer (little-endian extraction). Q6_K
// blocks are 210 bytes, so the words are not 4-byte aligned; extract a
// byte from the containing word.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 31u) / 32u;
  uint wg = gl_WorkGroupID.x;
  uint row_base = (wg / col_tiles) * 32u;
  uint col_base = (wg % col_tiles) * 32u;
  uint my_row = tid / 32u;
  uint my_col = tid % 32u;
  uint row_a = row_base + my_row;
  uint row_w = col_base + my_col;
  bool has_out = row_a < m && row_w < n;
  uint blocks = k / 256u;
  float acc = 0.0;
  uint pair = tid >> 2u;
  uint col = pair & 31u;
  uint sub = (pair >> 5u) & 7u;
  uint lane0 = (tid & 3u) * 8u;
  uint gc = col_base + col;
  uint n2 = sub >> 2u;
  uint q = sub & 3u;
  for (uint b = 0u; b < blocks; ++b) {
    if (gc < n) {
      uint base = gc * (blocks * 210u) + b * 210u;
      float d = fp16_at(base + 208u);
      int scale = int(wbyte(base + 192u + n2 * 8u + lane0 / 16u + 2u * q));
      if (scale >= 128) {
        scale -= 256;
      }
      float ds = d * float(scale);
      for (uint kk = 0u; kk < 8u; ++kk) {
        uint l = lane0 + kk;
        uint ql = wbyte(base + n2 * 64u + (q % 2u) * 32u + l);
        uint qh = wbyte(base + 128u + n2 * 32u + l);
        uint low = q < 2u ? (ql & 15u) : (ql >> 4u);
        uint high = ((qh >> (2u * q)) & 3u) << 4u;
        int qv = int(low | high) - 32;
        tile[(n2 * 128u + q * 32u + l) * 32u + col] = ds * float(qv);
      }
    }
    barrier();
    if (has_out) {
      uint abase = row_a * k + b * 256u;
      for (uint n2 = 0u; n2 < 2u; ++n2) {
        for (uint q = 0u; q < 4u; ++q) {
          for (uint l = 0u; l < 32u; ++l) {
            uint elem = n2 * 128u + q * 32u + l;
            acc += a[abase + elem] * tile[elem * 32u + my_col];
          }
        }
      }
    }
    barrier();
  }
  if (has_out) {
    c[row_a * n + row_w] = acc;
  }
}
