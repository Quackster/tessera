#version 450

// Tiled batched Q6_K GEMM: one workgroup handles 8 activation rows x one
// weight column; the 256 Q6_K elements of a block are dequantized once
// into shared memory and reused across the rows. Thread `e` is element
// `e`: n2 = e/128, q = (e%128)/32, l = e%32; the scale byte is
// 192 + n2*8 + l/16 + 2*q, the low nibble byte is 0 or 32 (q even or odd)
// at n2*64 + l, and the 2-bit high comes from byte 128 + n2*32 + l at
// bits 2*q. The dot uses the gemm_q6k order (n2, l, q1..q4). Dispatch is
// ceil(m / 8) * n workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_q6k_batched" contract (tessera API): buffers and scalars match
// gemm_q6k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// Byte `offset` of the Q6_K buffer (little-endian extraction). Q6_K
// blocks are 210 bytes, so the words are not 4-byte aligned; extract a
// byte from the containing word.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

shared float wq[256];

void main() {
  uint wg = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint base_row = (wg / n) * 8u;
  uint row_w = wg % n;
  bool dot_valid = tid < 8u && base_row + tid < m;
  uint row_a = base_row + tid;
  uint blocks = k / 256u;
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = row_w * (blocks * 210u) + b * 210u;
    float d = fp16_at(base + 208u);
    uint e = tid;
    uint n2 = e / 128u;
    uint q = (e % 128u) / 32u;
    uint l = e % 32u;
    uint ql = wbyte(base + n2 * 64u + (q % 2u) * 32u + l);
    uint qh = wbyte(base + 128u + n2 * 32u + l);
    uint low = q < 2u ? (ql & 15u) : (ql >> 4u);
    uint high = ((qh >> (2u * q)) & 3u) << 4u;
    int scale = int(wbyte(base + 192u + n2 * 8u + l / 16u + 2u * q));
    if (scale >= 128) {
      scale -= 256;
    }
    int qv = int(low | high) - 32;
    wq[e] = d * float(scale) * float(qv);
    barrier();
    if (dot_valid) {
      uint ab = row_a * k + b * 256u;
      for (uint g = 0u; g < 2u; ++g) {
        for (uint li = 0u; li < 32u; ++li) {
          uint e0 = g * 128u + li;
          acc += a[ab + e0] * wq[e0];
          acc += a[ab + e0 + 32u] * wq[e0 + 32u];
          acc += a[ab + e0 + 64u] * wq[e0 + 64u];
          acc += a[ab + e0 + 96u] * wq[e0 + 96u];
        }
      }
    }
    barrier();
  }
  if (dot_valid) {
    c[row_a * n + row_w] = acc;
  }
}
