#version 450

// Tiled batched Q6_K GEMM: one workgroup covers 32 activation rows x 8
// weight columns with one thread per output, so every thread computes.
// Element e = n2*128 + q*32 + l (n2 = e/128, q = (e%128)/32, l = e%32):
// the scale byte is 192 + n2*8 + l/16 + 2*q, the nibble byte is
// n2*64 + (q%2)*32 + l, and the 2-bit high comes from byte
// 128 + n2*32 + l at bits 2*q. The dot keeps the gemm_q6k order
// (n2, l, q1..q4). Dispatch is ceil(m / 32) * ceil(n / 8) workgroups of
// 256.
layout(local_size_x = 256) in;

// "gemm_q6k_batched" contract (tessera API): buffers and scalars match
// gemm_q6k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

// Byte `offset` of the Q6_K buffer (little-endian extraction). Q6_K
// blocks are 210 bytes, so the words are not 4-byte aligned; extract a
// byte from the containing word.
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 7u) / 8u;
  uint wg = gl_WorkGroupID.x;
  uint row_a = (wg / col_tiles) * 32u + tid / 8u;
  uint row_w = (wg % col_tiles) * 8u + tid % 8u;
  if (row_a >= m || row_w >= n) {
    return;
  }
  uint blocks = k / 256u;
  uint abase = row_a * k;
  uint wbase = row_w * (blocks * 210u);
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = wbase + b * 210u;
    float d = fp16_at(base + 208u);
    // Element order (0..255): n2 = e/128, q = (e%128)/32, l = e%32.
    for (uint n2 = 0u; n2 < 2u; ++n2) {
      for (uint q = 0u; q < 4u; ++q) {
        for (uint l = 0u; l < 32u; ++l) {
          uint ql = wbyte(base + n2 * 64u + (q % 2u) * 32u + l);
          uint qh = wbyte(base + 128u + n2 * 32u + l);
          uint low = q < 2u ? (ql & 15u) : (ql >> 4u);
          uint high = ((qh >> (2u * q)) & 3u) << 4u;
          int scale = int(wbyte(base + 192u + n2 * 8u + l / 16u + 2u * q));
          if (scale >= 128) {
            scale -= 256;
          }
          int qv = int(low | high) - 32;
          acc += a[abase + b * 256u + n2 * 128u + q * 32u + l] *
                 (d * float(scale) * float(qv));
        }
      }
    }
  }
  c[row_a * n + row_w] = acc;
}
