#version 450

#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_shader_8bit_storage : require

// Warp-per-output Q2_0 GEMV; see gemm_q4k_vec for the launch contract.
layout(local_size_x = 256) in;

layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint8_t w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

// 32-lane (warp-equivalent) reduction; the cluster leader writes the result.
float reduce32(float v) {
  return subgroupClusteredAdd(v, 32u);
}


uint wbyte(uint offset) {
  return uint(w[offset]);
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint split = pc.v[6];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= m * n) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint blocks = k / 64u;
  uint per = blocks / split;
  uint b0 = gl_WorkGroupID.y * per;
  uint row_a = idx / n;
  uint row_w = idx % n;
  uint w_base = row_w * (blocks * 18u);
  float acc = 0.0;
  uint byte_off = lane / 4u;
  uint shift = 2u * (lane % 4u);
  for (uint b = b0; b < b0 + per; ++b) {
    uint base = w_base + b * 18u;
    float d = fp16_at(base);
    uint lo = (wbyte(base + 2u + byte_off) >> shift) & 3u;
    uint hi = (wbyte(base + 10u + byte_off) >> shift) & 3u;
    acc += a[row_a * k + b * 64u + lane] * (float(lo) - 1.0) * d;
    acc += a[row_a * k + b * 64u + lane + 32u] * (float(hi) - 1.0) * d;
  }

  float sum = reduce32(acc);
  if ((gl_SubgroupInvocationID % 32u) == 0u) {
    c[gl_WorkGroupID.y * (m * n) + idx] = sum;
  }
}
