#version 450

// Tiled batched IQ4_XS GEMM: one workgroup handles 8 activation rows x one
// weight column; the 256 IQ4_XS elements of a block are dequantized once
// into shared memory and reused across the rows. Thread `e` is element
// `e`: ib = e/32, j = e%16, the nibble byte is `8 + ib*16 + j` (low nibble
// for the low half of the sub-block, high for the high half), the 6-bit
// scale is the 4 low bits at `4 + ib/2` plus the 2 high bits at bit `2*ib`
// of the u16 at 2, and the value is `d * (scale - 32) * codebook[nibble]`.
// The dot uses the gemm_iq4xs order (ib, j, low then high). Dispatch is
// ceil(m / 8) * n workgroups of 256.
layout(local_size_x = 256) in;

// "gemm_iq4xs_batched" contract (tessera API): buffers and scalars match
// gemm_iq4xs (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) buffer A {
  float a[];
};

layout(set = 0, binding = 1) buffer W {
  uint w[];
};

layout(set = 0, binding = 2) buffer C {
  float c[];
};

// IQ4 codebook (ports kvalues_iq4nl).
const int kValues[16] =
    int[16](-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53,
             69, 89, 113);

// Byte `offset` of the weight buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

shared float wq[256];

void main() {
  uint wg = gl_WorkGroupID.x;
  uint tid = gl_LocalInvocationID.x;
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint base_row = (wg / n) * 8u;
  uint row_w = wg % n;
  bool dot_valid = tid < 8u && base_row + tid < m;
  uint row_a = base_row + tid;
  uint blocks = k / 256u;
  float acc = 0.0;
  for (uint b = 0u; b < blocks; ++b) {
    uint base = row_w * (blocks * 136u) + b * 136u;
    float d = fp16_at(base);
    uint scales_h = wbyte(base + 2u) | (wbyte(base + 3u) << 8);
    uint e = tid;
    uint ib = e / 32u;
    uint lane = e % 32u;
    uint j = lane % 16u;
    uint byte = wbyte(base + 8u + ib * 16u + j);
    uint nib = lane < 16u ? (byte & 15u) : (byte >> 4u);
    uint packed = wbyte(base + 4u + ib / 2u);
    uint ls = ((packed >> (4u * (ib % 2u))) & 15u) |
              (((scales_h >> (2u * ib)) & 3u) << 4u);
    float dl = d * (float(ls) - 32.0);
    wq[e] = dl * float(kValues[nib]);
    barrier();
    if (dot_valid) {
      uint ab = row_a * k + b * 256u;
      for (uint g = 0u; g < 8u; ++g) {
        for (uint jj = 0u; jj < 16u; ++jj) {
          uint e0 = g * 32u + jj;
          acc += a[ab + e0] * wq[e0];
          acc += a[ab + e0 + 16u] * wq[e0 + 16u];
        }
      }
    }
    barrier();
  }
  if (dot_valid) {
    c[row_a * n + row_w] = acc;
  }
}
