uint wbyte(uint offset) {
  return uint(w[offset]);
}

uint wbyte2(uint offset) {
  return uint(w2[offset]);
}

float fp16_at2(uint offset) {
  uint h = wbyte2(offset) | (wbyte2(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

float reduce32(float v) {
  return subgroupClusteredAdd(v, 32u);
}


void main() {
  uint hidden = pc.v[0];
  uint inter = pc.v[2];
  uint top_k = pc.v[4];
  uint gate_stride = pc.v[6];
  uint up_stride = pc.v[8];
  uint warps = gl_WorkGroupSize.x / 32u;
  uint idx = gl_WorkGroupID.x * warps + (gl_LocalInvocationID.x / 32u);
  if (idx >= inter * top_k) {
    return;
  }
  uint lane = gl_LocalInvocationID.x % 32u;
  uint j = idx % inter;
  uint slot = idx / inter;
  uint expert = ids[slot];
  uint blocks = hidden / 256u;
  uint g_base = expert * gate_stride + j * blocks * 82u;
  uint u_base = expert * up_stride + j * blocks * 82u;
  float gate_acc = 0.0;
  float up_acc = 0.0;
  uint abase = 0u;
  for (uint b = 0; b < blocks; ++b) {
    uint wb = g_base + b * 82u;
    float d = fp16_at(wb);
    {
    uint ib = lane / 4u;
    uint il = lane % 4u;
    uint qh = wbyte(wb + 66u + ib);
    uint sc = wbyte(wb + 74u + ib);
    uint gi = (wbyte(wb + 2u + 4u * ib + il) |
               ((qh << (8u - 2u * il)) & 0x300u)) & 0x3FFu;
    uint glo = kGridLo[gi];
    uint ghi = kGridHi[gi];
    float dl = d * (0.5 + float((sc >> (4u * (il / 2u))) & 15u)) * 0.25;
    uint signs = wbyte(wb + 34u + 4u * ib + il);
    uint t = ib * 32u + il * 8u;
    for (uint j = 0u; j < 4u; ++j) {
      float m0 = ((signs & (1u << j)) > 0u) ? -1.0 : 1.0;
      gate_acc += x[abase + b * 256u + t + j] * (dl * float((glo >> (8u * j)) & 0xFFu) * m0);
    }
    for (uint j = 0u; j < 4u; ++j) {
      float m1 = ((signs & (1u << (j + 4u))) > 0u) ? -1.0 : 1.0;
      gate_acc += x[abase + b * 256u + t + 4u + j] * (dl * float((ghi >> (8u * j)) & 0xFFu) * m1);
    }
    }
    wb = u_base + b * 82u;
    d = fp16_at2(wb);
    {
    uint ib = lane / 4u;
    uint il = lane % 4u;
    uint qh = wbyte2(wb + 66u + ib);
    uint sc = wbyte2(wb + 74u + ib);
    uint gi = (wbyte2(wb + 2u + 4u * ib + il) |
               ((qh << (8u - 2u * il)) & 0x300u)) & 0x3FFu;
    uint glo = kGridLo[gi];
    uint ghi = kGridHi[gi];
    float dl = d * (0.5 + float((sc >> (4u * (il / 2u))) & 15u)) * 0.25;
    uint signs = wbyte2(wb + 34u + 4u * ib + il);
    uint t = ib * 32u + il * 8u;
    for (uint j = 0u; j < 4u; ++j) {
      float m0 = ((signs & (1u << j)) > 0u) ? -1.0 : 1.0;
      up_acc += x[abase + b * 256u + t + j] * (dl * float((glo >> (8u * j)) & 0xFFu) * m0);
    }
    for (uint j = 0u; j < 4u; ++j) {
      float m1 = ((signs & (1u << (j + 4u))) > 0u) ? -1.0 : 1.0;
      up_acc += x[abase + b * 256u + t + 4u + j] * (dl * float((ghi >> (8u * j)) & 0xFFu) * m1);
    }
    }
  }
  float gs = reduce32(gate_acc);
  float us = reduce32(up_acc);
  if ((gl_SubgroupInvocationID % 32u) == 0u) {
    phi[slot * inter + j] = (gs / (1.0 + exp(-gs))) * us;
  }
}
