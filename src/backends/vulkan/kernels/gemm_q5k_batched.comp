#version 450

// Tiled batched Q5_K GEMM: one workgroup covers 32 activation rows x 32
// weight columns over 1024 threads. Each 256-element block is dequantized
// once into shared memory and reused across the 32 rows. The dot keeps
// the gemm_q5k order. Dispatch is ceil(m / 32) * ceil(n / 32) workgroups
// of 1024.
layout(local_size_x = 1024) in;

// "gemm_q5k_batched" contract (tessera API): buffers and scalars match
// gemm_q5k (m, n, k, k a multiple of 256). Scalars are 64-bit, so field
// m lives at pc.v[0], n at pc.v[2], k at pc.v[4].
layout(push_constant) uniform PushConstants {
  uint v[8];
} pc;

layout(set = 0, binding = 0) readonly buffer A {
  float a[];
};

layout(set = 0, binding = 1) readonly buffer W {
  uint w[];
};

layout(set = 0, binding = 2) writeonly buffer C {
  float c[];
};

shared float tile[8192];

// Byte `offset` of the Q5_K buffer (little-endian extraction).
uint wbyte(uint offset) {
  return (w[offset >> 2] >> ((offset & 3) << 3)) & 0xFF;
}

// IEEE binary16 (little-endian) -> fp32, exact.
float fp16_at(uint offset) {
  uint h = wbyte(offset) | (wbyte(offset + 1) << 8);
  uint exp = (h >> 10) & 31;
  uint mant = h & 1023;
  float value;
  if (exp == 0) {
    value = float(mant) * exp2(-24.0);
  } else if (exp == 31) {
    value = mant > 0 ? 0.0 / 0.0 : 1.0 / 0.0;
  } else {
    value = (1.0 + float(mant) / 1024.0) * exp2(float(exp) - 15.0);
  }
  return (h & 32768) > 0 ? -value : value;
}

// The 6-bit scale/min pair of sub-block j (same packing as Q4_K).
void scale_min4(uint j, uint base, out uint scale, out uint min) {
  uint sj = wbyte(base + 4 + j);
  uint sj4 = wbyte(base + 8 + j);
  uint sjm4 = wbyte(base + j);
  if (j < 4) {
    scale = sj & 63;
    min = sj4 & 63;
  } else {
    scale = (sj4 & 15) | ((sjm4 >> 6) << 4);
    min = (sj4 >> 4) | ((sj >> 6) << 4);
  }
}

void main() {
  uint m = pc.v[0];
  uint n = pc.v[2];
  uint k = pc.v[4];
  uint tid = gl_LocalInvocationID.x;
  uint col_tiles = (n + 31u) / 32u;
  uint wg = gl_WorkGroupID.x;
  uint row_base = (wg / col_tiles) * 32u;
  uint col_base = (wg % col_tiles) * 32u;
  uint my_row = tid / 32u;
  uint my_col = tid % 32u;
  uint row_a = row_base + my_row;
  uint row_w = col_base + my_col;
  bool has_out = row_a < m && row_w < n;
  uint blocks = k / 256u;
  float acc = 0.0;
  uint pair = tid >> 2u;
  uint col = pair & 31u;
  uint s = (pair >> 5u) & 7u;
  uint lane0 = (tid & 3u) * 8u;
  uint gc = col_base + col;
  uint grp = s / 2u;
  uint par = s % 2u;
  for (uint b = 0u; b < blocks; ++b) {
    if (gc < n) {
      uint base = gc * (blocks * 176u) + b * 176u;
      float d = fp16_at(base);
      float dmin = fp16_at(base + 2u);
      uint sc, mn;
      scale_min4(s, base, sc, mn);
      float dsc = d * float(sc);
      float dmm = dmin * float(mn);
      for (uint kk = 0u; kk < 8u; ++kk) {
        uint lane = lane0 + kk;
        uint low = wbyte(base + 48u + grp * 32u + lane);
        uint high = wbyte(base + 16u + lane);
        uint nib = par != 0u ? (low >> 4u) : (low & 15u);
        uint hb = (high & (1u << s)) != 0u ? 16u : 0u;
        tile[(s * 32u + lane) * 32u + col] = dsc * float(nib + hb) - dmm;
      }
    }
    barrier();
    if (has_out) {
      uint abase = row_a * k + b * 256u;
      for (uint s = 0u; s < 8u; ++s) {
        for (uint lane = 0u; lane < 32u; ++lane) {
          uint elem = s * 32u + lane;
          acc += a[abase + elem] * tile[elem * 32u + my_col];
        }
      }
    }
    barrier();
  }
  if (has_out) {
    c[row_a * n + row_w] = acc;
  }
}
